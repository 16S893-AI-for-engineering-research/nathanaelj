---
import '../styles/globals.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { resolvePath } from '../lib/paths';

interface Props {
  title: string;
  description?: string;
  /**
   * Site chrome (header + footer + top page glow). Set `false` for immersive
   * views that own the entire viewport — e.g. the presentation deck viewer,
   * which must cover the fixed header and supplies its own exit control.
   */
  chrome?: boolean;
}

const { title, description = "Nathanael Jenkins' portfolio for MIT 16.S897: AI Agents for Engineering Research", chrome = true } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={resolvePath("/favicon.svg")} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} | 16.S897 Portfolio</title>
  </head>
  <body class={chrome ? undefined : 'is-immersive'}>
    {chrome && <Header currentPath={currentPath} />}
    <main>
      <slot />
    </main>
    {chrome && <Footer />}
  </body>
</html>

<style is:global>
  /* Ensure body takes full height */
  html, body {
    height: 100%;
  }

  body {
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  /* Immersive mode (chrome={false}): the page content is the whole viewport.
     Drop the page-top glow overlay (it sits above `main`) and the scrollbars,
     and clear `main`'s stacking context so nothing can paint over the view. */
  body.is-immersive::before {
    display: none;
  }

  body.is-immersive,
  html:has(body.is-immersive) {
    overflow: hidden;
  }

  body.is-immersive main {
    z-index: auto;
  }
</style>
