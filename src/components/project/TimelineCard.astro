---
import type { ProjectMilestone } from '../../data/project';
import { resolvePath } from '../../lib/paths';
import PlasmaGraphic from './PlasmaGraphic.astro';
import AgentGraphic from './AgentGraphic.astro';

interface Props {
  milestone: ProjectMilestone;
  index: number;
}

const { milestone, index } = Astro.props;
const formattedNumber = String(milestone.number).padStart(2, '0');
const linkHref = resolvePath(milestone.slug);
---

<div class="timeline-item" data-reveal={String(Math.min(index + 1, 5))}>
  <!-- Geometric rail node along the vertical timeline track -->
  <div class="timeline-node-container" aria-hidden="true">
    <div class="timeline-node">
      <div class="timeline-node__inner"></div>
    </div>
  </div>

  <!-- The Timeline Card -->
  <article class="project-card group">
    <!-- Stretched keyboard-accessible anchor covering the card -->
    <a
      href={linkHref}
      class="project-card__trigger"
      aria-label={`Open Milestone ${milestone.number}: ${milestone.title} (${milestone.date})`}
    ></a>

    <!-- Big translucent watermark numeral in top-right -->
    <span class="project-card__watermark" aria-hidden="true">
      {formattedNumber}
    </span>

    <!-- Corner HUD crosshairs -->
    <span class="card-hud-corner card-hud-corner--tl" aria-hidden="true"></span>
    <span class="card-hud-corner card-hud-corner--tr" aria-hidden="true"></span>
    <span class="card-hud-corner card-hud-corner--bl" aria-hidden="true"></span>
    <span class="card-hud-corner card-hud-corner--br" aria-hidden="true"></span>

    <!-- Header metadata -->
    <div class="project-card__header">
      <time class="project-card__date">
        {milestone.date}
      </time>
    </div>

    <!-- Title & Tagline -->
    <h2 class="project-card__title">
      {milestone.title}
    </h2>

    {milestone.tagline && (
      <p class="project-card__tagline">
        {milestone.tagline}
      </p>
    )}

    <!-- Summary description -->
    <p class="project-card__summary">
      {milestone.summary}
    </p>

    <!-- Optional Visual Graphic / Image Container -->
    {milestone.graphicType === 'plasma' && (
      <div class="my-4 pointer-events-none">
        <PlasmaGraphic />
      </div>
    )}

    {milestone.graphicType === 'agent' && (
      <div class="my-4 pointer-events-none">
        <AgentGraphic />
      </div>
    )}

    {milestone.image && (
      <div class="my-4 relative overflow-hidden border border-solar/20 bg-void-950 pointer-events-none">
        <img
          src={milestone.image}
          alt={milestone.title}
          class="w-full h-48 object-cover opacity-90 group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-void-950/80 via-transparent to-transparent"></div>
      </div>
    )}

    <!-- Interactive Call To Action Cue -->
    <div class="project-card__cue" aria-hidden="true">
      <span>Open {milestone.title}</span>
      <span class="project-card__cue-arrow text-base">→</span>
    </div>
  </article>
</div>
