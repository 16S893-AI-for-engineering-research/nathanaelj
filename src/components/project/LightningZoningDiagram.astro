---
/**
 * LightningZoningDiagram.astro
 * High-fidelity 2D aircraft lightning zoning map based on Boeing 737 CAD geometry.
 * Standard aerospace lightning zoning (ARP 5414):
 * - Zone 1A: Initial attachment (low hang-on) — Radome, engine inlet cowls, wing outer tips, empennage tips
 * - Zone 1B: Initial attachment (long hang-on) — Trailing edges of Zone 1A regions, tailcone
 * - Zone 1C: Transition zone — Cockpit canopy & engine mid cowls
 * - Zone 2A: Swept stroke (low hang-on) — Main fuselage cylinder, aft engine cowls
 * - Zone 2B: Swept stroke (long hang-on) — Trailing edge regions of swept stroke zones
 * - Zone 3: Current conduction — Bulk wing structures and stabilizers
 */
---

<div class="lightning-zoning-container bg-void-950 border border-solar/30 my-8 overflow-hidden">
  <!-- Minimal Header -->
  <div class="p-3 sm:p-4 bg-void-900/90 border-b border-solar/20 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 bg-solar inline-block"></span>
      <span class="font-mono text-xs font-semibold text-solar uppercase tracking-wider">
        Zoning map
      </span>
    </div>
  </div>

  <!-- Diagram & Detail Grid -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-0 border-b border-solar/20">

    <!-- Left (8 cols): Authentic Aircraft Top-Down Planform -->
    <div class="md:col-span-7 lg:col-span-8 p-4 sm:p-6 bg-[#070503] flex flex-col items-center justify-center border-b md:border-b-0 md:border-r border-solar/20">
      <svg
        id="full-aircraft-svg"
        viewBox="0 0 600 620"
        class="w-full max-w-[500px] h-auto"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <!-- Centerline -->
        <line x1="300" y1="15" x2="300" y2="600" stroke="rgba(255,156,26,0.12)" stroke-dasharray="4 4" stroke-width="1" />

        <!-- ==================== WINGS ==================== -->
        <!-- Bulk Wing (Zone 3 - Current Conduction) -->
        <g class="z-3">
          <!-- Left Wing Bulk -->
          <path
            d="M 266.4 242.2
               L 70.9 356.1
               L 70.9 382.8
               L 183.3 348.2
               L 266.4 333.5
               Z"
            fill="#38bdf8"
            fill-opacity="0.82"
            stroke="#38bdf8"
            stroke-width="1.2"
          />
          <!-- Right Wing Bulk -->
          <path
            d="M 333.6 242.2
               L 529.1 356.1
               L 529.1 382.8
               L 416.7 348.2
               L 333.6 333.5
               Z"
            fill="#38bdf8"
            fill-opacity="0.82"
            stroke="#38bdf8"
            stroke-width="1.2"
          />
        </g>

        <!-- Wingtip Outer Cap (Zone 1A - Initial Attachment) -->
        <g class="z-1A">
          <!-- Left Outermost Tip -->
          <path
            d="M 70.9 356.1
               L 63.6 359.7
               L 63.6 379.0
               L 70.9 377.0
               Z"
            fill="#f43f5e"
            fill-opacity="0.92"
            stroke="#ffffff"
            stroke-width="1.2"
          />
          <!-- Right Outermost Tip -->
          <path
            d="M 529.1 356.1
               L 536.4 359.7
               L 536.4 379.0
               L 529.1 377.0
               Z"
            fill="#f43f5e"
            fill-opacity="0.92"
            stroke="#ffffff"
            stroke-width="1.2"
          />
        </g>

        <!-- Wingtip Trailing Edge (Zone 1B - Initial Attachment Long Hang-on) -->
        <g class="z-1B">
          <!-- Left Wingtip TE Strip -->
          <path
            d="M 70.9 377.0
               L 63.6 379.0
               L 63.6 385.1
               L 70.9 382.8
               Z"
            fill="#b91c1c"
            fill-opacity="0.95"
            stroke="#f43f5e"
            stroke-width="1.2"
          />
          <!-- Right Wingtip TE Strip -->
          <path
            d="M 529.1 377.0
               L 536.4 379.0
               L 536.4 385.1
               L 529.1 382.8
               Z"
            fill="#b91c1c"
            fill-opacity="0.95"
            stroke="#f43f5e"
            stroke-width="1.2"
          />
        </g>

        <!-- Wing Detail Callout Box on Left Wingtip -->
        <rect
          x="50"
          y="348"
          width="35"
          height="45"
          fill="none"
          stroke="#ff9c1a"
          stroke-width="1.2"
          stroke-dasharray="3 3"
        />
        <text x="50" y="342" fill="#ffb84d" font-family="'IBM Plex Mono', monospace" font-size="8" font-weight="bold">
          DETAIL VIEW ↗
        </text>

        <!-- ==================== HORIZONTAL STABILIZERS ==================== -->
        <!-- Bulk Stabilizers (Zone 3 - Current Conduction) -->
        <g class="z-3">
          <!-- Left HTail -->
          <path
            d="M 289.9 529.8
               L 207.0 582.5
               L 207.0 592.5
               L 289.9 574.9
               Z"
            fill="#38bdf8"
            fill-opacity="0.82"
            stroke="#38bdf8"
            stroke-width="1"
          />
          <!-- Right HTail -->
          <path
            d="M 310.1 529.8
               L 393.0 582.5
               L 393.0 592.5
               L 310.1 574.9
               Z"
            fill="#38bdf8"
            fill-opacity="0.82"
            stroke="#38bdf8"
            stroke-width="1"
          />
        </g>

        <!-- HTail Outer Tips (Zone 1A - Initial Attachment) -->
        <g class="z-1A">
          <!-- Left HTail Tip -->
          <path
            d="M 207.0 582.5
               L 199.7 586.9
               L 199.7 594.0
               L 207.0 592.5
               Z"
            fill="#f43f5e"
            fill-opacity="0.92"
            stroke="#ffffff"
            stroke-width="1"
          />
          <!-- Right HTail Tip -->
          <path
            d="M 393.0 582.5
               L 400.3 586.9
               L 400.3 594.0
               L 393.0 592.5
               Z"
            fill="#f43f5e"
            fill-opacity="0.92"
            stroke="#ffffff"
            stroke-width="1"
          />
        </g>

        <!-- HTail Trailing Edge (Zone 1B - Initial Attachment Long Hang-on) -->
        <g class="z-1B">
          <!-- Left HTail TE -->
          <path
            d="M 218.0 591.0
               L 199.7 594.0
               L 199.7 597.2
               L 218.0 594.5
               Z"
            fill="#b91c1c"
            fill-opacity="0.95"
            stroke="#f43f5e"
            stroke-width="1"
          />
          <!-- Right HTail TE -->
          <path
            d="M 382.0 591.0
               L 400.3 594.0
               L 400.3 597.2
               L 382.0 594.5
               Z"
            fill="#b91c1c"
            fill-opacity="0.95"
            stroke="#f43f5e"
            stroke-width="1"
          />
        </g>

        <!-- ==================== FUSELAGE ==================== -->
        <!-- Main Fuselage Tube (Zone 2A - Swept Stroke) -->
        <g class="z-2A">
          <path
            d="M 276.8 93.1
               L 323.2 93.1
               L 333.6 242.2
               L 333.6 345.0
               L 322.0 460.0
               L 310.1 530.0
               L 303.8 574.0
               L 296.2 574.0
               L 289.9 530.0
               L 278.0 460.0
               L 266.4 345.0
               L 266.4 242.2
               Z"
            fill="#eab308"
            fill-opacity="0.85"
            stroke="#eab308"
            stroke-width="1.2"
          />
        </g>

        <!-- Vertical Tail Spine (Zone 3 Bulk & 1B Trailing Edge) -->
        <g class="z-3">
          <rect x="298" y="475" width="4" height="90" fill="#38bdf8" fill-opacity="0.8" />
        </g>
        <g class="z-1B">
          <rect x="298.5" y="565" width="3" height="9" fill="#b91c1c" />
        </g>

        <!-- Tailcone Tip (Zone 1B - Initial Attachment Long Hang-on) -->
        <g class="z-1B">
          <path
            d="M 296.2 574.0
               L 303.8 574.0
               L 300.0 580.0
               Z"
            fill="#b91c1c"
            fill-opacity="0.95"
            stroke="#f43f5e"
            stroke-width="1"
          />
        </g>

        <!-- Cockpit Canopy (Zone 1C - Transition Zone) -->
        <g class="z-1C">
          <path
            d="M 279.9 74.1
               L 320.1 74.1
               L 323.2 93.1
               L 276.8 93.1
               Z"
            fill="#f97316"
            fill-opacity="0.9"
            stroke="#f97316"
            stroke-width="1.2"
          />
        </g>

        <!-- Nose Radome (Zone 1A - Initial Attachment) -->
        <g class="z-1A">
          <path
            d="M 300.0 25.0
               C 306.0 40.0 315.0 56.0 320.1 74.1
               L 279.9 74.1
               C 285.0 56.0 294.0 40.0 300.0 25.0
               Z"
            fill="#f43f5e"
            fill-opacity="0.95"
            stroke="#ffffff"
            stroke-width="1.2"
          />
        </g>

        <!-- ==================== ENGINES ==================== -->
        <!-- Left Engine -->
        <!-- Inlet Lip (1A) -->
        <g class="z-1A">
          <path
            d="M 214.0 220.0
               C 214.0 216.0 246.0 216.0 246.0 220.0
               L 246.0 234.0
               L 214.0 234.0
               Z"
            fill="#f43f5e"
            fill-opacity="0.92"
            stroke="#ffffff"
            stroke-width="1"
          />
        </g>
        <!-- Mid Cowl (1C - Transition Zone) -->
        <g class="z-1C">
          <rect x="214.0" y="234.0" width="32" height="14" fill="#f97316" fill-opacity="0.9" stroke="#f97316" stroke-width="1" />
        </g>
        <!-- Aft Cowl (2A - Swept Stroke) -->
        <g class="z-2A">
          <path
            d="M 214.0 248.0
               L 246.0 248.0
               L 243.0 272.0
               L 217.0 272.0
               Z"
            fill="#eab308"
            fill-opacity="0.85"
            stroke="#eab308"
            stroke-width="1"
          />
        </g>
        <!-- Exhaust Rim (2B - Swept Stroke Long Hang-on) -->
        <g class="z-2B">
          <path
            d="M 217.0 272.0
               L 243.0 272.0
               L 241.0 275.5
               L 219.0 275.5
               Z"
            fill="#b45309"
            fill-opacity="0.95"
            stroke="#fbbf24"
            stroke-width="1"
          />
        </g>

        <!-- Right Engine -->
        <!-- Inlet Lip (1A) -->
        <g class="z-1A">
          <path
            d="M 354.0 220.0
               C 354.0 216.0 386.0 216.0 386.0 220.0
               L 386.0 234.0
               L 354.0 234.0
               Z"
            fill="#f43f5e"
            fill-opacity="0.92"
            stroke="#ffffff"
            stroke-width="1"
          />
        </g>
        <!-- Mid Cowl (1C - Transition Zone) -->
        <g class="z-1C">
          <rect x="354.0" y="234.0" width="32" height="14" fill="#f97316" fill-opacity="0.9" stroke="#f97316" stroke-width="1" />
        </g>
        <!-- Aft Cowl (2A - Swept Stroke) -->
        <g class="z-2A">
          <path
            d="M 354.0 248.0
               L 386.0 248.0
               L 383.0 272.0
               L 357.0 272.0
               Z"
            fill="#eab308"
            fill-opacity="0.85"
            stroke="#eab308"
            stroke-width="1"
          />
        </g>
        <!-- Exhaust Rim (2B - Swept Stroke Long Hang-on) -->
        <g class="z-2B">
          <path
            d="M 357.0 272.0
               L 383.0 272.0
               L 381.0 275.5
               L 359.0 275.5
               Z"
            fill="#b45309"
            fill-opacity="0.95"
            stroke="#fbbf24"
            stroke-width="1"
          />
        </g>

        <!-- Aircraft Overall Contour Outline -->
        <path
          d="M 300.0 25.0
             C 306.0 40.0 315.0 56.0 320.1 74.1
             L 323.2 93.1
             L 333.6 242.2
             L 333.6 345.0
             L 322.0 460.0
             L 310.1 530.0
             L 303.8 574.0
             L 300.0 580.0
             L 296.2 574.0
             L 289.9 530.0
             L 278.0 460.0
             L 266.4 345.0
             L 266.4 242.2
             L 276.8 93.1
             L 279.9 74.1
             C 285.0 56.0 294.0 40.0 300.0 25.0
             Z"
          fill="none"
          stroke="rgba(255,255,255,0.3)"
          stroke-width="1"
        />
      </svg>
    </div>

    <!-- Right (4-5 cols): Wingtip Planform Detail View & Legend -->
    <div class="md:col-span-5 lg:col-span-4 p-4 sm:p-5 bg-void-950 flex flex-col justify-between">

      <!-- Wingtip Callout Container -->
      <div class="border border-solar/30 bg-void-900/90 p-3.5 mb-4">
        <div class="flex items-center justify-between border-b border-solar/20 pb-1.5 mb-2.5 font-mono text-[11px]">
          <span class="text-solar font-bold">DETAIL VIEW: WINGTIP</span>
          <span class="text-void-400 text-[10px]">OUTBOARD TIP</span>
        </div>

        <!-- Wingtip Vector Graphic -->
        <svg
          id="wingtip-detail-svg"
          viewBox="0 0 320 180"
          class="w-full h-auto bg-[#070503] border border-solar/20"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <!-- Zone 3 (Inboard Bulk Wing) -->
          <g class="z-3">
            <path d="M 210 35 L 310 25 L 310 155 L 210 155 Z" fill="#38bdf8" fill-opacity="0.8" stroke="#38bdf8" stroke-width="1.2" />
            <text x="250" y="95" fill="#ffffff" font-family="'IBM Plex Mono', monospace" font-size="10" font-weight="bold">3</text>
          </g>

          <!-- Zone 2A (Swept Inboard) -->
          <g class="z-2A">
            <path d="M 115 45 L 210 35 L 210 138 L 115 138 Z" fill="#eab308" fill-opacity="0.85" stroke="#eab308" stroke-width="1.2" />
            <text x="155" y="95" fill="#000000" font-family="'IBM Plex Mono', monospace" font-size="10" font-weight="bold">2A</text>
          </g>

          <!-- Zone 2B (Trailing Edge 5cm of 2A) -->
          <g class="z-2B">
            <path d="M 115 138 L 210 138 L 210 155 L 115 155 Z" fill="#b45309" fill-opacity="0.95" stroke="#fbbf24" stroke-width="1.2" />
            <text x="145" y="150" fill="#ffffff" font-family="'IBM Plex Mono', monospace" font-size="8.5" font-weight="bold">2B (TE)</text>
          </g>

          <!-- Zone 1A (Outer Tip Body) -->
          <g class="z-1A">
            <path d="M 30 65 C 30 52 60 48 115 45 L 115 138 L 48 138 C 33 125 30 90 30 65 Z" fill="#f43f5e" fill-opacity="0.9" stroke="#ffffff" stroke-width="1.2" />
            <text x="65" y="95" fill="#ffffff" font-family="'IBM Plex Mono', monospace" font-size="10" font-weight="bold">1A</text>
          </g>

          <!-- Zone 1B (Trailing Edge 5cm of 1A) -->
          <g class="z-1B">
            <path d="M 48 138 L 115 138 L 115 155 L 54 155 C 50 148 49 142 48 138 Z" fill="#b91c1c" fill-opacity="0.95" stroke="#f43f5e" stroke-width="1.2" />
            <text x="60" y="150" fill="#ffffff" font-family="'IBM Plex Mono', monospace" font-size="8.5" font-weight="bold">1B (TE)</text>
          </g>

          <!-- Orientations -->
          <text x="100" y="20" fill="#8f7e6f" font-family="'IBM Plex Mono', monospace" font-size="8">▲ LEADING EDGE</text>
          <text x="100" y="172" fill="#8f7e6f" font-family="'IBM Plex Mono', monospace" font-size="8">▼ TRAILING EDGE</text>
          <text x="8" y="105" fill="#ff9c1a" font-family="'IBM Plex Mono', monospace" font-size="8" transform="rotate(-90 10 105)">◄ TIP</text>
        </svg>
      </div>

      <!-- Zone Legend Table -->
      <div class="space-y-1.5 text-[11px] font-mono">
        <div class="flex items-center justify-between p-2 bg-void-900/60 border-l-2 border-[#f43f5e]">
          <span class="text-white font-semibold">1A: Initial Attachment</span>
          <span></span>
        </div>
        <div class="flex items-center justify-between p-2 bg-void-900/60 border-l-2 border-[#b91c1c]">
          <span class="text-white font-semibold">1B: Initial Attachment</span>
          <span class="text-solar font-bold tracking-wider">Long hang-on</span>
        </div>
        <div class="flex items-center justify-between p-2 bg-void-900/60 border-l-2 border-[#f97316]">
          <span class="text-white font-semibold">1C: Transition zone</span>
          <span></span>
        </div>
        <div class="flex items-center justify-between p-2 bg-void-900/60 border-l-2 border-[#eab308]">
          <span class="text-white font-semibold">2A: Swept Stroke</span>
          <span></span>
        </div>
        <div class="flex items-center justify-between p-2 bg-void-900/60 border-l-2 border-[#b45309]">
          <span class="text-white font-semibold">2B: Swept Stroke</span>
          <span class="text-solar font-bold tracking-wider">Long hang-on</span>
        </div>
        <div class="flex items-center justify-between p-2 bg-void-900/60 border-l-2 border-[#38bdf8]">
          <span class="text-white font-semibold">3: Current conduction</span>
          <span></span>
        </div>
      </div>

    </div>

  </div>
</div>
