---
// SimulationPipelineDiagram.astro
// Static SVG block diagram illustrating the aircraft lightning zoning simulation pipeline
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 1040 480"
  class="w-full h-auto select-none"
  style="font-family: 'Sora', sans-serif;"
  aria-label="Aircraft lightning zoning simulation pipeline block diagram"
>
  <defs>
    <!-- Arrowhead Markers -->
    <marker
      id="pipeline-arr-solar"
      viewBox="0 0 10 10"
      refX="7"
      refY="5"
      markerWidth="6"
      markerHeight="6"
      orient="auto-start-reverse"
    >
      <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#ff9c1a" />
    </marker>
    <marker
      id="pipeline-arr-red"
      viewBox="0 0 10 10"
      refX="7"
      refY="5"
      markerWidth="6"
      markerHeight="6"
      orient="auto-start-reverse"
    >
      <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#f87171" />
    </marker>
    <marker
      id="pipeline-arr-blue"
      viewBox="0 0 10 10"
      refX="7"
      refY="5"
      markerWidth="6"
      markerHeight="6"
      orient="auto-start-reverse"
    >
      <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#38bdf8" />
    </marker>
  </defs>

  <!-- ==================== ROW HIGHLIGHTING BANDS ==================== -->
  <!-- Row 1: global-scale (purple translucent band) -->
  <rect
    x="18"
    y="142"
    width="697"
    height="92"
    fill="#a855f7"
    fill-opacity="0.08"
    stroke="#a855f7"
    stroke-opacity="0.25"
    stroke-width="1"
  />
  <rect x="18" y="142" width="4" height="92" fill="#a855f7" />

  <!-- Row 2: local-scale (emerald translucent band across first two columns) -->
  <rect
    x="18"
    y="298"
    width="697"
    height="92"
    fill="#10b981"
    fill-opacity="0.08"
    stroke="#10b981"
    stroke-opacity="0.25"
    stroke-width="1"
  />
  <rect x="18" y="298" width="4" height="92" fill="#10b981" />

  <!-- ==================== COLUMN HIGHLIGHTING BANDS ==================== -->
  <!-- Column 1: initial attachment (red-ish) -->
  <rect
    x="175"
    y="142"
    width="250"
    height="308"
    fill="#ef4444"
    fill-opacity="0.09"
    stroke="#ef4444"
    stroke-opacity="0.4"
    stroke-width="1.5"
  />
  <!-- Corner accents for Column 1 -->
  <path d="M 175 152 L 175 142 L 185 142" stroke="#f87171" stroke-width="2" fill="none" />
  <path d="M 425 152 L 425 142 L 415 142" stroke="#f87171" stroke-width="2" fill="none" />
  <path d="M 175 440 L 175 450 L 185 450" stroke="#f87171" stroke-width="2" fill="none" />
  <path d="M 425 440 L 425 450 L 415 450" stroke="#f87171" stroke-width="2" fill="none" />

  <!-- Column 2: swept stroke (blue-ish) -->
  <rect
    x="460"
    y="142"
    width="250"
    height="308"
    fill="#38bdf8"
    fill-opacity="0.09"
    stroke="#38bdf8"
    stroke-opacity="0.4"
    stroke-width="1.5"
  />
  <!-- Corner accents for Column 2 -->
  <path d="M 460 152 L 460 142 L 470 142" stroke="#38bdf8" stroke-width="2" fill="none" />
  <path d="M 710 152 L 710 142 L 700 142" stroke="#38bdf8" stroke-width="2" fill="none" />
  <path d="M 460 440 L 460 450 L 470 450" stroke="#38bdf8" stroke-width="2" fill="none" />
  <path d="M 710 440 L 710 450 L 700 450" stroke="#38bdf8" stroke-width="2" fill="none" />

  <!-- Column 3: zoning (solar-amber, wraps Row 2 and bottom label) -->
  <rect
    x="745"
    y="298"
    width="250"
    height="152"
    fill="#ff9c1a"
    fill-opacity="0.09"
    stroke="#ff9c1a"
    stroke-opacity="0.4"
    stroke-width="1.5"
  />
  <!-- Corner accents for Column 3 -->
  <path d="M 745 308 L 745 298 L 755 298" stroke="#ffb84d" stroke-width="2" fill="none" />
  <path d="M 995 308 L 995 298 L 985 298" stroke="#ffb84d" stroke-width="2" fill="none" />
  <path d="M 745 440 L 745 450 L 755 450" stroke="#ffb84d" stroke-width="2" fill="none" />
  <path d="M 995 440 L 995 450 L 985 450" stroke="#ffb84d" stroke-width="2" fill="none" />

  <!-- ==================== COLUMN LABELS (BELOW COLUMNS) ==================== -->
  <!-- Column 1: initial attachment -->
  <g transform="translate(300, 422)">
    <rect x="-80" y="-14" width="160" height="28" fill="#180a0a" stroke="#ef4444" stroke-opacity="0.8" stroke-width="1" />
    <text text-anchor="middle" y="5" font-family="'IBM Plex Mono', monospace" font-size="11" font-weight="600" fill="#fca5a5" letter-spacing="0.8">
      initial attachment
    </text>
  </g>

  <!-- Column 2: swept stroke -->
  <g transform="translate(585, 422)">
    <rect x="-70" y="-14" width="140" height="28" fill="#06121c" stroke="#38bdf8" stroke-opacity="0.8" stroke-width="1" />
    <text text-anchor="middle" y="5" font-family="'IBM Plex Mono', monospace" font-size="11" font-weight="600" fill="#7dd3fc" letter-spacing="0.8">
      swept stroke
    </text>
  </g>

  <!-- Column 3: zoning -->
  <g transform="translate(870, 422)">
    <rect x="-55" y="-14" width="110" height="28" fill="#1c1208" stroke="#ff9c1a" stroke-opacity="0.8" stroke-width="1" />
    <text text-anchor="middle" y="5" font-family="'IBM Plex Mono', monospace" font-size="11" font-weight="600" fill="#ffb84d" letter-spacing="0.8">
      zoning
    </text>
  </g>

  <!-- ==================== ROW LABELS (Left) ==================== -->
  <!-- Row 1: global-scale -->
  <g transform="translate(26, 188)">
    <rect x="0" y="-18" width="128" height="36" fill="#160d1f" stroke="#a855f7" stroke-opacity="0.6" stroke-width="1" />
    <text x="64" y="5" text-anchor="middle" font-family="'IBM Plex Mono', monospace" font-size="11.5" font-weight="600" fill="#e9d5ff" letter-spacing="0.8">
      global-scale
    </text>
  </g>

  <!-- Row 2: local-scale -->
  <g transform="translate(26, 344)">
    <rect x="0" y="-18" width="128" height="36" fill="#091b14" stroke="#10b981" stroke-opacity="0.6" stroke-width="1" />
    <text x="64" y="5" text-anchor="middle" font-family="'IBM Plex Mono', monospace" font-size="11.5" font-weight="600" fill="#a7f3d0" letter-spacing="0.8">
      local-scale
    </text>
  </g>

  <!-- ==================== ARROWS & CONNECTORS ==================== -->
  <g fill="none" stroke="#ff9c1a" stroke-width="2">
    <!-- Center stem down from Mesh Gen to split point -->
    <line x1="442.5" y1="86" x2="442.5" y2="118" />

    <!-- Horizontal bridge splitting left to Col 1 and right to Col 2 -->
    <line x1="300" y1="118" x2="585" y2="118" />

    <!-- Downward arrow into Electrostatics (Row 1 Col 1) -->
    <line x1="300" y1="118" x2="300" y2="156" marker-end="url(#pipeline-arr-solar)" />

    <!-- Downward arrow into Fluid dynamics (Row 1 Col 2) -->
    <line x1="585" y1="118" x2="585" y2="156" marker-end="url(#pipeline-arr-solar)" />

    <!-- Vertical Arrow: Electrostatics -> Initial attachment model (Col 1) -->
    <line x1="300" y1="220" x2="300" y2="312" marker-end="url(#pipeline-arr-red)" stroke="#f87171" stroke-width="2" />

    <!-- Vertical Arrow: Fluid dynamics -> Swept stroke model (Col 2) -->
    <line x1="585" y1="220" x2="585" y2="312" marker-end="url(#pipeline-arr-blue)" stroke="#38bdf8" stroke-width="2" />

    <!-- Horizontal Arrow: Initial attachment model -> Swept stroke model -->
    <line x1="415" y1="344" x2="470" y2="344" marker-end="url(#pipeline-arr-solar)" stroke="#ff9c1a" stroke-width="2" />

    <!-- Horizontal Arrow: Swept stroke model -> Zoning mapping -->
    <line x1="700" y1="344" x2="755" y2="344" marker-end="url(#pipeline-arr-solar)" stroke="#ff9c1a" stroke-width="2" />
  </g>

  <!-- Split junction node -->
  <circle cx="442.5" cy="118" r="3.5" fill="#ff9c1a" />

  <!-- ==================== MAIN BOXES (font-size 18px / text-lg) ==================== -->
  <!-- Top: Mesh Generation (x: 332.5, y: 22, w: 220, h: 64) -->
  <g transform="translate(332.5, 22)">
    <rect width="220" height="64" fill="#120d08" stroke="#ff9c1a" stroke-opacity="0.6" stroke-width="1.5" />
    <path d="M 0 6 L 0 0 L 6 0" stroke="#ff9c1a" stroke-width="1.5" fill="none" />
    <path d="M 220 6 L 220 0 L 214 0" stroke="#ff9c1a" stroke-width="1.5" fill="none" />
    <path d="M 0 58 L 0 64 L 6 64" stroke="#ff9c1a" stroke-width="1.5" fill="none" />
    <path d="M 220 58 L 220 64 L 214 64" stroke="#ff9c1a" stroke-width="1.5" fill="none" />
    <text x="110" y="38" text-anchor="middle" font-size="18" font-weight="600" fill="#ffffff">
      Mesh Generation
    </text>
  </g>

  <!-- Row 1 Col 1: Electrostatics (x: 185, y: 156, w: 230, h: 64) -->
  <g transform="translate(185, 156)">
    <rect width="230" height="64" fill="#160b0b" stroke="#ef4444" stroke-opacity="0.65" stroke-width="1.5" />
    <path d="M 0 6 L 0 0 L 6 0" stroke="#ef4444" stroke-width="1.5" fill="none" />
    <path d="M 230 6 L 230 0 L 224 0" stroke="#ef4444" stroke-width="1.5" fill="none" />
    <path d="M 0 58 L 0 64 L 6 64" stroke="#ef4444" stroke-width="1.5" fill="none" />
    <path d="M 230 58 L 230 64 L 224 64" stroke="#ef4444" stroke-width="1.5" fill="none" />
    <text x="115" y="38" text-anchor="middle" font-size="18" font-weight="600" fill="#ffffff">
      Electrostatics
    </text>
  </g>

  <!-- Row 1 Col 2: Fluid dynamics (x: 470, y: 156, w: 230, h: 64) -->
  <g transform="translate(470, 156)">
    <rect width="230" height="64" fill="#08121c" stroke="#38bdf8" stroke-opacity="0.65" stroke-width="1.5" />
    <path d="M 0 6 L 0 0 L 6 0" stroke="#38bdf8" stroke-width="1.5" fill="none" />
    <path d="M 230 6 L 230 0 L 224 0" stroke="#38bdf8" stroke-width="1.5" fill="none" />
    <path d="M 0 58 L 0 64 L 6 64" stroke="#38bdf8" stroke-width="1.5" fill="none" />
    <path d="M 230 58 L 230 64 L 224 64" stroke="#38bdf8" stroke-width="1.5" fill="none" />
    <text x="115" y="38" text-anchor="middle" font-size="18" font-weight="600" fill="#ffffff">
      Fluid dynamics
    </text>
  </g>

  <!-- Row 2 Col 1: Initial attachment model (x: 185, y: 312, w: 230, h: 64) -->
  <g transform="translate(185, 312)">
    <rect width="230" height="64" fill="#160b0b" stroke="#ef4444" stroke-opacity="0.75" stroke-width="1.5" />
    <path d="M 0 6 L 0 0 L 6 0" stroke="#ef4444" stroke-width="1.5" fill="none" />
    <path d="M 230 6 L 230 0 L 224 0" stroke="#ef4444" stroke-width="1.5" fill="none" />
    <path d="M 0 58 L 0 64 L 6 64" stroke="#ef4444" stroke-width="1.5" fill="none" />
    <path d="M 230 58 L 230 64 L 224 64" stroke="#ef4444" stroke-width="1.5" fill="none" />
    <text x="115" y="27" text-anchor="middle" font-size="18" font-weight="600" fill="#ffffff">
      Initial attachment
    </text>
    <text x="115" y="51" text-anchor="middle" font-size="18" font-weight="600" fill="#ffffff">
      model
    </text>
  </g>

  <!-- Row 2 Col 2: Swept stroke model (x: 470, y: 312, w: 230, h: 64) -->
  <g transform="translate(470, 312)">
    <rect width="230" height="64" fill="#08121c" stroke="#38bdf8" stroke-opacity="0.75" stroke-width="1.5" />
    <path d="M 0 6 L 0 0 L 6 0" stroke="#38bdf8" stroke-width="1.5" fill="none" />
    <path d="M 230 6 L 230 0 L 224 0" stroke="#38bdf8" stroke-width="1.5" fill="none" />
    <path d="M 0 58 L 0 64 L 6 64" stroke="#38bdf8" stroke-width="1.5" fill="none" />
    <path d="M 230 58 L 230 64 L 224 64" stroke="#38bdf8" stroke-width="1.5" fill="none" />
    <text x="115" y="27" text-anchor="middle" font-size="18" font-weight="600" fill="#ffffff">
      Swept stroke
    </text>
    <text x="115" y="51" text-anchor="middle" font-size="18" font-weight="600" fill="#ffffff">
      model
    </text>
  </g>

  <!-- Row 2 Col 3: Zoning mapping (x: 755, y: 312, w: 230, h: 64) -->
  <g transform="translate(755, 312)">
    <rect width="230" height="64" fill="#1c1208" stroke="#ff9c1a" stroke-opacity="0.85" stroke-width="1.5" />
    <path d="M 0 6 L 0 0 L 6 0" stroke="#ff9c1a" stroke-width="1.5" fill="none" />
    <path d="M 230 6 L 230 0 L 224 0" stroke="#ff9c1a" stroke-width="1.5" fill="none" />
    <path d="M 0 58 L 0 64 L 6 64" stroke="#ff9c1a" stroke-width="1.5" fill="none" />
    <path d="M 230 58 L 230 64 L 224 64" stroke="#ff9c1a" stroke-width="1.5" fill="none" />
    <text x="115" y="38" text-anchor="middle" font-size="18" font-weight="600" fill="#ffb84d">
      Zoning mapping
    </text>
  </g>
</svg>
