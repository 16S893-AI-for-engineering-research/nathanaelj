---
// SimulationPipelineDiagram.astro
// Static SVG block diagram illustrating the aircraft lightning zoning simulation pipeline
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 900 450"
  class="w-full h-auto select-none"
  style="font-family: 'Sora', sans-serif;"
  aria-label="Aircraft lightning zoning simulation pipeline block diagram"
>
  <defs>
    <!-- Arrowhead Markers -->
    <marker
      id="pipeline-arr-solar"
      viewBox="0 0 10 10"
      refX="7"
      refY="5"
      markerWidth="6"
      markerHeight="6"
      orient="auto-start-reverse"
    >
      <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#ff9c1a" />
    </marker>
    <marker
      id="pipeline-arr-red"
      viewBox="0 0 10 10"
      refX="7"
      refY="5"
      markerWidth="6"
      markerHeight="6"
      orient="auto-start-reverse"
    >
      <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#f87171" />
    </marker>
    <marker
      id="pipeline-arr-blue"
      viewBox="0 0 10 10"
      refX="7"
      refY="5"
      markerWidth="6"
      markerHeight="6"
      orient="auto-start-reverse"
    >
      <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#38bdf8" />
    </marker>
  </defs>

  <!-- ==================== ROW HIGHLIGHTING BANDS ==================== -->
  <!-- Row 1: global-scale (purple translucent band across row 1) -->
  <rect
    x="18"
    y="146"
    width="598"
    height="76"
    fill="#a855f7"
    fill-opacity="0.08"
    stroke="#a855f7"
    stroke-opacity="0.25"
    stroke-width="1"
  />
  <rect x="18" y="146" width="3.5" height="76" fill="#a855f7" />

  <!-- Row 2: local-scale (emerald translucent band across row 2) -->
  <rect
    x="18"
    y="254"
    width="833"
    height="106"
    fill="#10b981"
    fill-opacity="0.08"
    stroke="#10b981"
    stroke-opacity="0.25"
    stroke-width="1"
  />
  <rect x="18" y="254" width="3.5" height="106" fill="#10b981" />

  <!-- ==================== COLUMN HIGHLIGHTING BANDS ==================== -->
  <!-- Column 1: initial attachment (red-ish translucent shaded box) -->
  <rect
    x="167"
    y="72"
    width="206"
    height="282"
    fill="#ef4444"
    fill-opacity="0.09"
    stroke="#ef4444"
    stroke-opacity="0.4"
    stroke-width="1.5"
  />
  <!-- HUD Corner Accents for Column 1 -->
  <path d="M 167 80 L 167 72 L 175 72" stroke="#f87171" stroke-width="2" fill="none" />
  <path d="M 373 80 L 373 72 L 365 72" stroke="#f87171" stroke-width="2" fill="none" />
  <path d="M 167 346 L 167 354 L 175 354" stroke="#f87171" stroke-width="2" fill="none" />
  <path d="M 373 346 L 373 354 L 365 354" stroke="#f87171" stroke-width="2" fill="none" />

  <!-- Column 2: swept stroke (blue-ish translucent shaded box) -->
  <rect
    x="402"
    y="72"
    width="206"
    height="282"
    fill="#38bdf8"
    fill-opacity="0.09"
    stroke="#38bdf8"
    stroke-opacity="0.4"
    stroke-width="1.5"
  />
  <!-- HUD Corner Accents for Column 2 -->
  <path d="M 402 80 L 402 72 L 410 72" stroke="#38bdf8" stroke-width="2" fill="none" />
  <path d="M 608 80 L 608 72 L 600 72" stroke="#38bdf8" stroke-width="2" fill="none" />
  <path d="M 402 346 L 402 354 L 410 354" stroke="#38bdf8" stroke-width="2" fill="none" />
  <path d="M 608 346 L 608 354 L 600 354" stroke="#38bdf8" stroke-width="2" fill="none" />

  <!-- Column 3: zoning (solar translucent shaded box aligned with Row 2) -->
  <rect
    x="637"
    y="254"
    width="206"
    height="106"
    fill="#ff9c1a"
    fill-opacity="0.09"
    stroke="#ff9c1a"
    stroke-opacity="0.4"
    stroke-width="1.5"
  />
  <!-- HUD Corner Accents for Column 3 -->
  <path d="M 637 262 L 637 254 L 645 254" stroke="#ffb84d" stroke-width="2" fill="none" />
  <path d="M 843 262 L 843 254 L 835 254" stroke="#ffb84d" stroke-width="2" fill="none" />
  <path d="M 637 352 L 637 360 L 645 360" stroke="#ffb84d" stroke-width="2" fill="none" />
  <path d="M 843 352 L 843 360 L 835 360" stroke="#ffb84d" stroke-width="2" fill="none" />

  <!-- ==================== COLUMN LABELS ==================== -->
  <!-- Column 1 Header: initial attachment (red-ish) -->
  <g transform="translate(270, 92)">
    <rect x="-75" y="-13" width="150" height="26" fill="#180a0a" stroke="#ef4444" stroke-opacity="0.8" stroke-width="1" />
    <text text-anchor="middle" y="4" font-family="'IBM Plex Mono', monospace" font-size="10" font-weight="600" fill="#fca5a5" letter-spacing="0.8">
      initial attachment
    </text>
  </g>

  <!-- Column 2 Header: swept stroke (blue-ish) -->
  <g transform="translate(505, 92)">
    <rect x="-65" y="-13" width="130" height="26" fill="#06121c" stroke="#38bdf8" stroke-opacity="0.8" stroke-width="1" />
    <text text-anchor="middle" y="4" font-family="'IBM Plex Mono', monospace" font-size="10" font-weight="600" fill="#7dd3fc" letter-spacing="0.8">
      swept stroke
    </text>
  </g>

  <!-- Column 3 Header: zoning (aligned with Row 2) -->
  <g transform="translate(740, 274)">
    <rect x="-50" y="-12" width="100" height="24" fill="#1c1208" stroke="#ff9c1a" stroke-opacity="0.8" stroke-width="1" />
    <text text-anchor="middle" y="4" font-family="'IBM Plex Mono', monospace" font-size="10" font-weight="600" fill="#ffb84d" letter-spacing="0.8">
      zoning
    </text>
  </g>

  <!-- ==================== ROW LABELS (Left) ==================== -->
  <!-- Row 1: global-scale (purple) -->
  <g transform="translate(26, 184)">
    <rect x="0" y="-16" width="120" height="32" fill="#160d1f" stroke="#a855f7" stroke-opacity="0.6" stroke-width="1" />
    <text x="60" y="4" text-anchor="middle" font-family="'IBM Plex Mono', monospace" font-size="11" font-weight="600" fill="#e9d5ff" letter-spacing="0.8">
      global-scale
    </text>
  </g>

  <!-- Row 2: local-scale (emerald) -->
  <g transform="translate(26, 307)">
    <rect x="0" y="-16" width="120" height="32" fill="#091b14" stroke="#10b981" stroke-opacity="0.6" stroke-width="1" />
    <text x="60" y="4" text-anchor="middle" font-family="'IBM Plex Mono', monospace" font-size="11" font-weight="600" fill="#a7f3d0" letter-spacing="0.8">
      local-scale
    </text>
  </g>

  <!-- ==================== ARROWS & CONNECTORS ==================== -->
  <g fill="none" stroke="#ff9c1a" stroke-width="1.75">
    <!-- Center stem down from Mesh Gen to split point -->
    <line x1="387.5" y1="64" x2="387.5" y2="124" />

    <!-- Horizontal bridge splitting left to Col 1 and right to Col 2 -->
    <line x1="270" y1="124" x2="505" y2="124" />

    <!-- Downward arrow into Electrostatics (Row 1 Col 1) -->
    <line x1="270" y1="124" x2="270" y2="160" marker-end="url(#pipeline-arr-solar)" />

    <!-- Downward arrow into Fluid dynamics (Row 1 Col 2) -->
    <line x1="505" y1="124" x2="505" y2="160" marker-end="url(#pipeline-arr-solar)" />

    <!-- Vertical Arrow: Electrostatics -> Initial attachment model (Col 1) -->
    <line x1="270" y1="208" x2="270" y2="296" marker-end="url(#pipeline-arr-red)" stroke="#f87171" stroke-width="1.75" />

    <!-- Vertical Arrow: Fluid dynamics -> Swept stroke model (Col 2) -->
    <line x1="505" y1="208" x2="505" y2="296" marker-end="url(#pipeline-arr-blue)" stroke="#38bdf8" stroke-width="1.75" />

    <!-- Horizontal Arrow: Initial attachment model -> Swept stroke model -->
    <line x1="365" y1="320" x2="410" y2="320" marker-end="url(#pipeline-arr-solar)" stroke="#ff9c1a" stroke-width="1.75" />

    <!-- Horizontal Arrow: Swept stroke model -> Zoning mapping -->
    <line x1="600" y1="320" x2="645" y2="320" marker-end="url(#pipeline-arr-solar)" stroke="#ff9c1a" stroke-width="1.75" />
  </g>

  <!-- Split junction node -->
  <circle cx="387.5" cy="124" r="3" fill="#ff9c1a" />

  <!-- ==================== BOXES ==================== -->
  <!-- Top: Mesh Generation (x: 297.5, y: 18, w: 180, h: 46) -->
  <g transform="translate(297.5, 18)">
    <rect width="180" height="46" fill="#120d08" stroke="#ff9c1a" stroke-opacity="0.6" stroke-width="1.5" />
    <path d="M 0 5 L 0 0 L 5 0" stroke="#ff9c1a" stroke-width="1.5" fill="none" />
    <path d="M 180 5 L 180 0 L 175 0" stroke="#ff9c1a" stroke-width="1.5" fill="none" />
    <path d="M 0 41 L 0 46 L 5 46" stroke="#ff9c1a" stroke-width="1.5" fill="none" />
    <path d="M 180 41 L 180 46 L 175 46" stroke="#ff9c1a" stroke-width="1.5" fill="none" />
    <text x="90" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="#ffffff">
      Mesh Generation
    </text>
  </g>

  <!-- Row 1 Col 1: Electrostatics (x: 175, y: 160, w: 190, h: 48) -->
  <g transform="translate(175, 160)">
    <rect width="190" height="48" fill="#160b0b" stroke="#ef4444" stroke-opacity="0.6" stroke-width="1.5" />
    <path d="M 0 5 L 0 0 L 5 0" stroke="#ef4444" stroke-width="1.5" fill="none" />
    <path d="M 190 5 L 190 0 L 185 0" stroke="#ef4444" stroke-width="1.5" fill="none" />
    <path d="M 0 43 L 0 48 L 5 48" stroke="#ef4444" stroke-width="1.5" fill="none" />
    <path d="M 190 43 L 190 48 L 185 48" stroke="#ef4444" stroke-width="1.5" fill="none" />
    <text x="95" y="29" text-anchor="middle" font-size="13" font-weight="600" fill="#ffffff">
      Electrostatics
    </text>
  </g>

  <!-- Row 1 Col 2: Fluid dynamics (x: 410, y: 160, w: 190, h: 48) -->
  <g transform="translate(410, 160)">
    <rect width="190" height="48" fill="#08121c" stroke="#38bdf8" stroke-opacity="0.6" stroke-width="1.5" />
    <path d="M 0 5 L 0 0 L 5 0" stroke="#38bdf8" stroke-width="1.5" fill="none" />
    <path d="M 190 5 L 190 0 L 185 0" stroke="#38bdf8" stroke-width="1.5" fill="none" />
    <path d="M 0 43 L 0 48 L 5 48" stroke="#38bdf8" stroke-width="1.5" fill="none" />
    <path d="M 190 43 L 190 48 L 185 48" stroke="#38bdf8" stroke-width="1.5" fill="none" />
    <text x="95" y="29" text-anchor="middle" font-size="13" font-weight="600" fill="#ffffff">
      Fluid dynamics
    </text>
  </g>

  <!-- Row 2 Col 1: Initial attachment model (x: 175, y: 296, w: 190, h: 48) -->
  <g transform="translate(175, 296)">
    <rect width="190" height="48" fill="#160b0b" stroke="#ef4444" stroke-opacity="0.7" stroke-width="1.5" />
    <path d="M 0 5 L 0 0 L 5 0" stroke="#ef4444" stroke-width="1.5" fill="none" />
    <path d="M 190 5 L 190 0 L 185 0" stroke="#ef4444" stroke-width="1.5" fill="none" />
    <path d="M 0 43 L 0 48 L 5 48" stroke="#ef4444" stroke-width="1.5" fill="none" />
    <path d="M 190 43 L 190 48 L 185 48" stroke="#ef4444" stroke-width="1.5" fill="none" />
    <text x="95" y="22" text-anchor="middle" font-size="12" font-weight="600" fill="#ffffff">
      Initial attachment
    </text>
    <text x="95" y="37" text-anchor="middle" font-size="12" font-weight="600" fill="#ffffff">
      model
    </text>
  </g>

  <!-- Row 2 Col 2: Swept stroke model (x: 410, y: 296, w: 190, h: 48) -->
  <g transform="translate(410, 296)">
    <rect width="190" height="48" fill="#08121c" stroke="#38bdf8" stroke-opacity="0.7" stroke-width="1.5" />
    <path d="M 0 5 L 0 0 L 5 0" stroke="#38bdf8" stroke-width="1.5" fill="none" />
    <path d="M 190 5 L 190 0 L 185 0" stroke="#38bdf8" stroke-width="1.5" fill="none" />
    <path d="M 0 43 L 0 48 L 5 48" stroke="#38bdf8" stroke-width="1.5" fill="none" />
    <path d="M 190 43 L 190 48 L 185 48" stroke="#38bdf8" stroke-width="1.5" fill="none" />
    <text x="95" y="22" text-anchor="middle" font-size="12" font-weight="600" fill="#ffffff">
      Swept stroke
    </text>
    <text x="95" y="37" text-anchor="middle" font-size="12" font-weight="600" fill="#ffffff">
      model
    </text>
  </g>

  <!-- Row 2 Col 3: Zoning mapping (x: 645, y: 296, w: 190, h: 48) -->
  <g transform="translate(645, 296)">
    <rect width="190" height="48" fill="#1c1208" stroke="#ff9c1a" stroke-opacity="0.8" stroke-width="1.5" />
    <path d="M 0 5 L 0 0 L 5 0" stroke="#ff9c1a" stroke-width="1.5" fill="none" />
    <path d="M 190 5 L 190 0 L 185 0" stroke="#ff9c1a" stroke-width="1.5" fill="none" />
    <path d="M 0 43 L 0 48 L 5 48" stroke="#ff9c1a" stroke-width="1.5" fill="none" />
    <path d="M 190 43 L 190 48 L 185 48" stroke="#ff9c1a" stroke-width="1.5" fill="none" />
    <text x="95" y="29" text-anchor="middle" font-size="13" font-weight="600" fill="#ffb84d">
      Zoning mapping
    </text>
  </g>
</svg>
