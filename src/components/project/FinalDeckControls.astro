---
import { resolvePath } from '../../lib/paths';
---
<nav class="final-controls" aria-label="Presentation controls">
  <a href={resolvePath('/project')} aria-label="Exit to Project Timeline">← Timeline</a>
  <span class="controls-spacer"></span>
  <button type="button" data-prev aria-label="Previous slide" title="Previous slide (←)">←</button>
  <form class="deck-position" data-position aria-label="Go to slide" novalidate>
    <input class="deck-count" data-slide-number type="text" inputmode="numeric" enterkeyhint="go" pattern="[0-9]*" autocomplete="off" aria-label="Slide number; press Enter to navigate" title="Type a slide number and press Enter" value="01" />
    <span class="deck-total" data-total aria-label="Total slides"></span>
  </form>
  <button type="button" data-next aria-label="Next slide" title="Next slide (→ or Space)">→</button>
  <span class="controls-spacer"></span>
  <button type="button" data-fullscreen aria-label="Enter fullscreen" title="Toggle fullscreen (F)">Full screen</button>
</nav>
<div class="deck-progress" aria-hidden="true"></div>
<p class="deck-announcement" role="status" aria-live="polite" data-announcement></p>

<script>
  const deck = document.querySelector<HTMLElement>('.final-deck');
  if (deck) {
    const slides = Array.from(deck.querySelectorAll<HTMLElement>('[data-slide]'));
    const prev = deck.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = deck.querySelector<HTMLButtonElement>('[data-next]')!;
    const position = deck.querySelector<HTMLFormElement>('[data-position]')!;
    const number = deck.querySelector<HTMLInputElement>('[data-slide-number]')!;
    const announce = deck.querySelector<HTMLElement>('[data-announcement]')!;
    const fullscreenButton = deck.querySelector<HTMLButtonElement>('[data-fullscreen]')!;
    const stage = deck.querySelector<HTMLElement>('.final-stage')!;
    deck.querySelector<HTMLElement>('[data-total]')!.textContent = `/ ${String(slides.length).padStart(2, '0')}`;
    let index = 0;
    const fromHash = () => {
      const match = /^#(\d+)$/.exec(location.hash);
      return match ? Math.max(0, Math.min(slides.length - 1, Number(match[1]) - 1)) : 0;
    };
    const resize = () => {
      const scale = Math.min(deck.clientWidth / 1600, Math.max(0, deck.clientHeight - 58) / 900);
      deck.style.setProperty('--deck-scale', String(scale));
      stage.style.top = `${(deck.clientHeight - 38) / 2}px`;
    };
    const render = () => {
      slides.forEach((slide, i) => {
        slide.hidden = i !== index;
        slide.inert = i !== index;
        slide.setAttribute('aria-hidden', String(i !== index));
      });
      number.value = String(index + 1).padStart(2, '0');
      number.removeAttribute('aria-invalid');
      prev.disabled = index === 0;
      next.disabled = index === slides.length - 1;
      deck.style.setProperty('--progress', `${((index + 1) / slides.length) * 100}%`);
      announce.textContent = `Slide ${index + 1} of ${slides.length}: ${slides[index].dataset.title}`;
      document.title = `${slides[index].dataset.title} · Final Presentation`;
      stage.dataset.ready = 'true';
      // Load viewers only on their slide, and unload them when leaving it so
      // hidden WebGL render loops do not consume GPU resources.
      deck.querySelectorAll<HTMLIFrameElement>('[data-geometry]').forEach(frame => {
        const active = frame.closest<HTMLElement>('[data-slide]') === slides[index];
        if (active && !frame.hasAttribute('srcdoc')) frame.srcdoc = frame.dataset.geometrySource!;
        else if (!active && frame.hasAttribute('srcdoc')) frame.removeAttribute('srcdoc');
      });
      deck.dispatchEvent(new CustomEvent('deck:slidechange', { detail: { index } }));
    };
    function show(value: number) {
      index = Math.max(0, Math.min(slides.length - 1, value));
      history.replaceState(null, '', `#${index + 1}`);
      render();
    }
    position.addEventListener('submit', event => {
      event.preventDefault();
      const value = number.value.trim();
      const requested = Number(value);
      if (!/^\d+$/.test(value) || requested < 1 || requested > slides.length) {
        number.setAttribute('aria-invalid', 'true');
        announce.textContent = `Enter a slide number from 1 to ${slides.length}, then press Enter.`;
        number.select();
        return;
      }
      show(requested - 1);
      number.blur();
    });
    number.addEventListener('focus', () => number.select());
    number.addEventListener('input', () => number.removeAttribute('aria-invalid'));
    number.addEventListener('blur', () => { number.value = String(index + 1).padStart(2, '0'); number.removeAttribute('aria-invalid'); });
    number.addEventListener('keydown', event => {
      if (event.key === 'Enter') { event.preventDefault(); position.requestSubmit(); }
      else if (event.key === 'Escape') { event.preventDefault(); number.blur(); }
    });
    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    const toggleFullscreen = async () => {
      try {
        if (document.fullscreenElement) await document.exitFullscreen();
        else if (deck.requestFullscreen) await deck.requestFullscreen();
        else announce.textContent = 'Use your browser’s full-screen command to present.';
      } catch { announce.textContent = 'Full screen is unavailable. Use your browser’s full-screen command.'; }
    };
    fullscreenButton.addEventListener('click', toggleFullscreen);
    document.addEventListener('fullscreenchange', () => {
      fullscreenButton.textContent = document.fullscreenElement ? 'Exit full screen' : 'Full screen';
      fullscreenButton.setAttribute('aria-label', document.fullscreenElement ? 'Exit fullscreen' : 'Enter fullscreen');
      resize();
    });
    document.addEventListener('keydown', event => {
      if (event.ctrlKey || event.metaKey || event.altKey) return;
      if (event.target instanceof Element && event.target.closest('input, textarea, select, [contenteditable="true"]')) return;
      if ([' ', 'Enter'].includes(event.key) && event.target instanceof Element && event.target.closest('button, a')) return;
      if (['ArrowRight', 'ArrowDown', 'PageDown', ' '].includes(event.key)) { event.preventDefault(); show(index + 1); }
      else if (['ArrowLeft', 'ArrowUp', 'PageUp', 'Backspace'].includes(event.key)) { event.preventDefault(); show(index - 1); }
      else if (event.key === 'Home') { event.preventDefault(); show(0); }
      else if (event.key === 'End') { event.preventDefault(); show(slides.length - 1); }
      else if (event.key.toLowerCase() === 'f') { event.preventDefault(); void toggleFullscreen(); }
    });
    addEventListener('message', event => {
      const fromViewer = Array.from(deck.querySelectorAll<HTMLIFrameElement>('[data-geometry]')).some(frame => frame.contentWindow === event.source && !frame.closest<HTMLElement>('[data-slide]')?.hidden);
      if (!fromViewer || event.data?.type !== 'deck:navigate') return;
      const key = event.data.key;
      if (['ArrowRight', 'ArrowDown', 'PageDown', ' '].includes(key)) show(index + 1);
      else if (['ArrowLeft', 'ArrowUp', 'PageUp'].includes(key)) show(index - 1);
      else if (key === 'Home') show(0);
      else if (key === 'End') show(slides.length - 1);
      else if (key === 'f' || key === 'F') void toggleFullscreen();
    });
    let touch: { x: number; y: number } | null = null;
    stage.addEventListener('touchstart', e => { const t = e.changedTouches[0]; touch = { x: t.clientX, y: t.clientY }; }, { passive: true });
    stage.addEventListener('touchend', e => {
      if (!touch) return;
      const t = e.changedTouches[0], dx = t.clientX - touch.x, dy = t.clientY - touch.y;
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.5) show(index + (dx < 0 ? 1 : -1));
      touch = null;
    }, { passive: true });
    let idle: ReturnType<typeof setTimeout>;
    const wake = () => {
      deck.removeAttribute('data-idle');
      clearTimeout(idle);
      idle = setTimeout(() => deck.setAttribute('data-idle', ''), 2800);
    };
    ['pointermove', 'pointerdown', 'keydown', 'focusin'].forEach(type => document.addEventListener(type, wake, { passive: true }));
    addEventListener('resize', resize);
    addEventListener('hashchange', () => { index = fromHash(); render(); });
    index = fromHash();
    render();
    resize();
    wake();
  }
</script>
