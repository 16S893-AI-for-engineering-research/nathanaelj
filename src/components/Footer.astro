<footer class="border-t border-solar/15 py-8 cursor-default" id="site-footer">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <p class="text-void-500 text-xs cursor-default">
      © Nathanael Jenkins. Built with AI assistance, using Astro & Tailwind CSS.
    </p>
  </div>
</footer>

<script>
  // Easter Egg 2: Airplane Cursor
  const footer = document.getElementById('site-footer');
  footer?.addEventListener('click', () => {
    // A nice SVG airplane colored with the solar theme color (#ff9c1a), rotated -45 degrees
    const airplaneSvg = `data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='%23ff9c1a'><g transform='rotate(-45 12 12)'><path d='M21,16V14L13,9V3.5A1.5,1.5 0 0,0 11.5,2A1.5,1.5 0 0,0 10,3.5V9L2,14V16L10,13.5V19L8,20.5V22L11.5,21L15,22V20.5L13,19V13.5L21,16Z'/></g></svg>`;
    document.body.style.cursor = `url("${airplaneSvg}"), auto`;
  });
</script>
