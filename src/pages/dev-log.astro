---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Dev Log">
  <div class="max-w-4xl mx-auto px-6 py-20 pt-32">
    <h1 class="font-display text-5xl font-bold mb-12 text-solar">Development Log</h1>

    <!-- Dev Log Entries -->
    <div class="space-y-8">
      <!-- Entry Template -->
      <article class="border-l-2 border-solar/50 pl-8 py-4 hover:border-solar transition-colors duration-300">
        <div class="flex items-baseline gap-4 mb-2">
          <time class="font-mono text-sm text-solar">2024-09-10</time>
          <span class="text-xs px-2 py-1 bg-solar/10 text-solar font-mono border border-solar/30">setup</span>
        </div>
        <h3 class="font-sans text-2xl font-bold text-void-100 mb-3">
          Portfolio Setup Complete
        </h3>
        <p class="text-void-300 mb-2 font-sans">
          Configured the Astro + Tailwind portfolio with GitHub Pages deployment. Implemented the sunrise/sunset solar theme with warm accent colors and sharp design elements.
        </p>
        <p class="text-void-500 text-sm font-sans">
          Key accomplishments: GitHub Actions workflow, Tailwind theme system, Header/Footer components, responsive design foundation.
        </p>
      </article>

      <!-- Placeholder for more entries -->
      <div class="border-l-2 border-solar/20 pl-8 py-12 text-center">
        <p class="text-void-400 text-sm font-sans">
          More dev log entries will appear here as the project progresses...
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  article {
    transition: all 0.3s ease;
  }

  article:hover {
    transform: translateX(4px);
  }
</style>
