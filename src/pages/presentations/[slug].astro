---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import '@styles/presentations.css';

import { presentations } from '@data/presentations';
import { resolvePath } from '@lib/paths';
import { LAYOUTS } from '@components/presentations/slides/index.ts';

/**
 * Full-screen deck viewer. Every slide in the deck is rendered up front
 * (server-side, no client framework) and a tiny inline script toggles which
 * one is visible — arrow keys / space / click to advance, matching the
 * keyboard conventions of every other slide tool.
 *
 * `chrome={false}` on the layout drops the site header/footer: presenting is a
 * take-over-the-viewport mode, so the deck covers the (otherwise fixed) header
 * and offers its own ✕ exit control in the top-right instead.
 */
export const getStaticPaths: GetStaticPaths = () => {
  return presentations.map((presentation) => ({
    params: { slug: presentation.slug },
    props: { presentation },
  }));
};

const { presentation } = Astro.props;
const total = presentation.slides.length;
const exitHref = resolvePath('/presentations');
---

<BaseLayout title={presentation.title} description={presentation.summary} chrome={false}>
  <div class="pv-deck" id="pv-deck">
    <div class="pv-deck__stage">
      {presentation.slides.map((slide, i) => {
        const Layout = LAYOUTS[slide.layout];
        return (
          <div class="pv-deck__slide" data-slide-wrap data-active={i === 0 ? 'true' : 'false'} aria-hidden={i === 0 ? 'false' : 'true'}>
            <Layout slide={slide} index={i + 1} total={total} />
          </div>
        );
      })}
    </div>

    <a href={exitHref} class="pv-deck__exit" id="pv-exit" aria-label="Exit presentation">
      <span aria-hidden="true">&#10005;</span>
    </a>

    <div class="pv-deck__controls" id="pv-controls">
      <button type="button" class="pv-deck__btn" id="pv-prev" aria-label="Previous slide">← Prev</button>
      <span class="pv-deck__count" id="pv-count">1 / {total}</span>
      <button type="button" class="pv-deck__btn" id="pv-next" aria-label="Next slide">Next →</button>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ total }}>
  (() => {
    const stage = document.getElementById('pv-deck');
    if (!stage) return;
    const wraps = [...stage.querySelectorAll('[data-slide-wrap]')];
    const countEl = document.getElementById('pv-count');
    const prevBtn = document.getElementById('pv-prev');
    const nextBtn = document.getElementById('pv-next');
    const controls = document.getElementById('pv-controls');
    const exitLink = document.getElementById('pv-exit');

    let index = 0;

    const readHash = () => {
      const n = parseInt(location.hash.slice(1), 10);
      return Number.isFinite(n) && n >= 1 && n <= total ? n - 1 : 0;
    };

    function render({ updateHash = true } = {}) {
      // The stylesheet keys off the string "true" (`[data-active='true']`), so
      // set the value explicitly rather than toggling a bare attribute.
      wraps.forEach((w, i) => {
        const active = i === index;
        w.setAttribute('data-active', active ? 'true' : 'false');
        w.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
      if (countEl) countEl.textContent = `${index + 1} / ${total}`;
      if (prevBtn) prevBtn.disabled = index === 0;
      if (nextBtn) nextBtn.disabled = index === total - 1;
      if (updateHash) history.replaceState(null, '', `#${index + 1}`);
    }

    function go(delta) {
      index = Math.min(Math.max(index + delta, 0), total - 1);
      render();
    }

    prevBtn?.addEventListener('click', () => go(-1));
    nextBtn?.addEventListener('click', () => go(1));

    addEventListener('keydown', (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      if (['ArrowRight', 'ArrowDown', 'PageDown', ' '].includes(e.key)) {
        e.preventDefault();
        go(1);
      } else if (['ArrowLeft', 'ArrowUp', 'PageUp'].includes(e.key)) {
        e.preventDefault();
        go(-1);
      } else if (e.key === 'Home') {
        e.preventDefault();
        index = 0;
        render();
      } else if (e.key === 'End') {
        e.preventDefault();
        index = total - 1;
        render();
      } else if (e.key === 'f' || e.key === 'F') {
        e.preventDefault();
        if (document.fullscreenElement) document.exitFullscreen?.();
        else stage.requestFullscreen?.().catch(() => {});
      } else if (e.key === 'Escape' && !document.fullscreenElement) {
        location.href = exitLink?.getAttribute('href') || '/';
      }
    });

    // Click the right/left half of the stage to advance/go back —
    // ignore clicks on the controls or the exit link themselves.
    stage.addEventListener('click', (e) => {
      const target = e.target;
      if (target.closest('#pv-controls') || target.closest('#pv-exit')) return;
      const rect = stage.getBoundingClientRect();
      const fromLeft = (e.clientX - rect.left) / rect.width;
      go(fromLeft < 0.35 ? -1 : 1);
    });

    // Fade the controls/exit button out when idle, back in on movement —
    // keeps the chrome out of the way while presenting.
    let idleTimer;
    const summon = () => {
      controls?.removeAttribute('data-hidden');
      exitLink?.removeAttribute('data-hidden');
      clearTimeout(idleTimer);
      idleTimer = setTimeout(() => {
        controls?.setAttribute('data-hidden', 'true');
        exitLink?.setAttribute('data-hidden', 'true');
      }, 2400);
    };
    addEventListener('mousemove', summon, { passive: true });
    summon();

    index = readHash();
    render({ updateHash: false });
  })();
</script>
