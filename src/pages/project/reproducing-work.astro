---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolvePath } from '../../lib/paths';
import MilestoneNavigation from '../../components/project/MilestoneNavigation.astro';
import '../../styles/project.css';
---

<BaseLayout
  title="Reproducing work · Project"
  description="Reproducing work for the project."
>
  <div class="max-w-4xl mx-auto px-6 pt-16 pb-24">
    <nav class="mb-10" aria-label="Breadcrumb" data-reveal="1">
      <a
        href={resolvePath('/project')}
        class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-solar hover:text-solar-light transition-colors"
        style="border-bottom:none;"
      >
        <span aria-hidden="true">←</span> Back to Project Timeline
      </a>
    </nav>

    <header class="project-detail-header" data-reveal="1">
      <h1 class="text-4xl md:text-6xl font-display font-bold leading-[1.25] pb-3 mb-2">
        Reproducing Results
      </h1>

      <p class="text-solar-light text-xl font-sans font-light max-w-3xl leading-relaxed mb-3">
        The interaction between a lightning flash and an aircraft in flight (Larsson, 2002)
      </p>

      <time class="font-mono text-xs uppercase tracking-widest text-void-400 block">
        September 2026
      </time>
    </header>

    <article class="space-y-12 mt-10" data-reveal="2">
      <section>
        <h2 class="text-2xl md:text-3xl font-display font-bold text-void-100 mb-4">
          1. Original Work
        </h2>

        <p class="text-void-200 text-base md:text-lg leading-relaxed mb-4">
          <a href="https://doi.org/10.1016/S1631-0705(02)01410-X"  target="_blank" rel="noopener noreferrer">The interaction between a lightning flash and an aircraft in flight (Larsson, 2002)</a> is a seminal work that presents models related to the aircraft lightning swept stroke.
          <i>Coming soon... a summary of the results to be reproduced</i>
        </p>
      </section>

      <section>
        <h2 class="text-2xl md:text-3xl font-display font-bold text-void-100 mb-4">
          2. Reproduction
        </h2>

        <p class="text-void-200 text-base md:text-lg leading-relaxed mb-4">
          <i>Coming soon... a summary of the reproduction</i>
        </p>
      </section>

      <section>
        <h2 class="text-2xl md:text-3xl font-display font-bold text-void-100 mb-4">
          3. Evaluation
        </h2>

        <p class="text-void-200 text-base md:text-lg leading-relaxed mb-4">
          <i>Coming soon... evaluation of the reproduction</i>
        </p>
      </section>
    </article>

    <MilestoneNavigation currentSlug="/project/reproducing-work" />
  </div>
</BaseLayout>
