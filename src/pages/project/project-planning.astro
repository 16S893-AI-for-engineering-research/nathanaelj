---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolvePath } from '../../lib/paths';
import MilestoneNavigation from '../../components/project/MilestoneNavigation.astro';
import '../../styles/project.css';
---

<BaseLayout
  title="Project Planning · Project"
  description="Agent setup and strategic planning for the project."
>
  <div class="max-w-4xl mx-auto px-6 pt-16 pb-24">

    <!-- ===== Navigation Breadcrumb ===== -->
    <nav class="mb-10" aria-label="Breadcrumb" data-reveal="1">
      <a
        href={resolvePath('/project')}
        class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-solar hover:text-solar-light transition-colors"
        style="border-bottom:none;"
      >
        <span aria-hidden="true">←</span> Back to Project Timeline
      </a>
    </nav>

    <!-- ===== Header ===== -->
    <header class="project-detail-header" data-reveal="1">
      <h1 class="text-4xl md:text-6xl font-display font-bold leading-[1.25] pb-3 mb-2">
        Project Planning
      </h1>

      <p class="text-solar-light text-xl font-sans font-light max-w-3xl leading-relaxed mb-3">
        Agent setup and strategic planning
      </p>

      <time class="font-mono text-xs uppercase tracking-widest text-void-400 block">
        October 2026
      </time>
    </header>

    <!-- ===== Content Sections ===== -->
    <article class="space-y-12 mt-10" data-reveal="2">

      <!-- =========================================================================
           Section 1: Literature
           ========================================================================= -->
      <section>
        <h2 class="text-2xl md:text-3xl font-display font-bold text-void-100 mb-4">
          1. Literature
        </h2>

        <p class="text-void-200 text-base leading-relaxed mb-6">
          The foundational physics and numerical methods for aircraft lightning zoning are drawn from a core set of publications and working notes produced by the MIT Aerospace Plasma Group:
        </p>

        <!-- Reference Documents List -->
        <div class="border border-solar/20 bg-void-950 divide-y divide-solar/15 my-6">
          <div class="flex justify-between items-center px-4 py-2.5 bg-void-900/60">
            <span class="font-mono text-[10px] uppercase tracking-wider text-solar">Reference Publications</span>
            <span class="font-mono text-[10px] uppercase tracking-wider text-void-500">MIT Aerospace Plasma Group</span>
          </div>

          <!-- Item 1 -->
          <div class="p-4 flex flex-col sm:flex-row justify-between sm:items-center gap-3 hover:bg-void-900/30 transition-colors">
            <div class="min-w-0 pr-2">
              <div class="flex items-center gap-2 mb-1">
                <span class="font-mono text-[11px] text-solar font-semibold uppercase">Thesis · 2024</span>
                <span class="text-void-600 font-mono text-xs">/</span>
                <span class="font-mono text-[11px] text-void-400 uppercase">MIT</span>
              </div>
              <h3 class="font-sans font-semibold text-void-100 text-base leading-snug">
                Numerical Simulation of the Lightning Swept Stroke for the Zoning of Unconventional Aircraft
              </h3>
            </div>
            <a
              href="https://nathanaelj.github.io/Projects/FYPResources/NJenkins%20Thesis%20Final.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="lit-link-btn"
            >
              PDF <span aria-hidden="true">&#8599;</span>
            </a>
          </div>

          <!-- Item 2 -->
          <div class="p-4 flex flex-col sm:flex-row justify-between sm:items-center gap-3 hover:bg-void-900/30 transition-colors">
            <div class="min-w-0 pr-2">
              <div class="flex items-center gap-2 mb-1">
                <span class="font-mono text-[11px] text-solar font-semibold uppercase">Journal · 2024</span>
                <span class="text-void-600 font-mono text-xs">/</span>
                <span class="font-mono text-[11px] text-void-400 uppercase">IEEE Access</span>
              </div>
              <h3 class="font-sans font-semibold text-void-100 text-base leading-snug">
                Numerical Simulation of the Lightning Swept Stroke: Application to the Results From the NASA Storm Hazards Program
              </h3>
            </div>
            <a
              href="https://doi.org/10.1109/ACCESS.2024.3515833"
              target="_blank"
              rel="noopener noreferrer"
              class="lit-link-btn"
            >
              DOI <span aria-hidden="true">&#8599;</span>
            </a>
          </div>

          <!-- Item 3 -->
          <div class="p-4 flex flex-col sm:flex-row justify-between sm:items-center gap-3 hover:bg-void-900/30 transition-colors">
            <div class="min-w-0 pr-2">
              <div class="flex items-center gap-2 mb-1">
                <span class="font-mono text-[11px] text-solar font-semibold uppercase">Journal · 2025</span>
                <span class="text-void-600 font-mono text-xs">/</span>
                <span class="font-mono text-[11px] text-void-400 uppercase">IEEE Access</span>
              </div>
              <h3 class="font-sans font-semibold text-void-100 text-base leading-snug">
                A Physics-Based Approach to Aircraft Lightning Zoning: Zone 2
              </h3>
            </div>
            <a
              href="https://doi.org/10.1109/ACCESS.2025.3628197"
              target="_blank"
              rel="noopener noreferrer"
              class="lit-link-btn"
            >
              DOI <span aria-hidden="true">&#8599;</span>
            </a>
          </div>

          <!-- Item 4 -->
          <div class="p-4 flex flex-col sm:flex-row justify-between sm:items-center gap-3 hover:bg-void-900/30 transition-colors">
            <div class="min-w-0 pr-2">
              <div class="flex items-center gap-2 mb-1">
                <span class="font-mono text-[11px] text-solar font-semibold uppercase">Supplementary · 2024</span>
                <span class="text-void-600 font-mono text-xs">/</span>
                <span class="font-mono text-[11px] text-void-400 uppercase">Supplementary to IEEE Access (2025)</span>
              </div>
              <h3 class="font-sans font-semibold text-void-100 text-base leading-snug">
                Physical Interpretation of Swept Stroke Data
              </h3>
            </div>
            <a
              href="https://nathanaelj.github.io/Projects/PhDResources/IEEE_Suppl.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="lit-link-btn"
            >
              PDF <span aria-hidden="true">&#8599;</span>
            </a>
          </div>

          <!-- Item 5 -->
          <div class="p-4 flex flex-col sm:flex-row justify-between sm:items-center gap-3 hover:bg-void-900/30 transition-colors">
            <div class="min-w-0 pr-2">
              <div class="flex items-center gap-2 mb-1">
                <span class="font-mono text-[11px] text-solar font-semibold uppercase">Workshop · 2025</span>
                <span class="text-void-600 font-mono text-xs">/</span>
                <span class="font-mono text-[11px] text-void-400 uppercase">EUROCAE Zoning Workshop</span>
              </div>
              <h3 class="font-sans font-semibold text-void-100 text-base leading-snug">
                Mapping of Swept Stroke Physical-Quantities to Zoning Diagrams
              </h3>
            </div>
            <span class="inline-flex items-center justify-center font-mono text-[11px] text-void-500 border border-void-800 px-3 py-1.5 bg-void-900/40 shrink-0 uppercase tracking-wider">
              Workshop
            </span>
          </div>

          <!-- Item 6 -->
          <div class="p-4 flex flex-col sm:flex-row justify-between sm:items-center gap-3 hover:bg-void-900/30 transition-colors">
            <div class="min-w-0 pr-2">
              <div class="flex items-center gap-2 mb-1">
                <span class="font-mono text-[11px] text-solar font-semibold uppercase">Conference · 2026</span>
                <span class="text-void-600 font-mono text-xs">/</span>
                <span class="font-mono text-[11px] text-void-400 uppercase">ICOLSE</span>
              </div>
              <h3 class="font-sans font-semibold text-void-100 text-base leading-snug">
                An End-to-End Simulation-Based Workflow for Zoning
              </h3>
            </div>
            <span class="inline-flex items-center justify-center font-mono text-[11px] text-void-500 border border-void-800 px-3 py-1.5 bg-void-900/40 shrink-0 uppercase tracking-wider">
              Conference
            </span>
          </div>

          <!-- Item 7 -->
          <div class="p-4 flex flex-col sm:flex-row justify-between sm:items-center gap-3 hover:bg-void-900/30 transition-colors">
            <div class="min-w-0 pr-2">
              <div class="flex items-center gap-2 mb-1">
                <span class="font-mono text-[11px] text-solar font-semibold uppercase">Manuscript · 2026</span>
                <span class="text-void-600 font-mono text-xs">/</span>
                <span class="font-mono text-[11px] text-void-400 uppercase">In Preparation</span>
              </div>
              <h3 class="font-sans font-semibold text-void-100 text-base leading-snug">
                A Physics-Based Approach to Aircraft Lightning Zoning: Initial Attachment
              </h3>
            </div>
            <span class="inline-flex items-center justify-center font-mono text-[11px] text-void-500 border border-void-800 px-3 py-1.5 bg-void-900/40 shrink-0 uppercase tracking-wider">
              In Preparation
            </span>
          </div>
        </div>

        <!-- Ingestion Workflow Diagram -->
        <div class="project-sandbox-frame my-8">
          <div class="project-sandbox-frame__header">
            <span>Literature Ingestion &amp; Skill Pipeline</span>
          </div>

          <div class="w-full bg-void-950 p-4">
            <svg
              viewBox="0 0 1000 220"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              class="block w-full h-auto"
            >
              <defs>
                <linearGradient id="flowConnGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#ffb84d" />
                  <stop offset="100%" stop-color="#ff6633" />
                </linearGradient>
                <marker
                  id="flowArrow"
                  viewBox="0 0 12 12"
                  refX="11"
                  refY="6"
                  markerWidth="12"
                  markerHeight="12"
                  markerUnits="userSpaceOnUse"
                  orient="auto"
                >
                  <path d="M 1 1 L 11 6 L 1 11 z" fill="#ff7a3d" />
                </marker>
                <filter id="outputGlow">
                  <feGaussianBlur stdDeviation="2" result="blur" />
                  <feMerge>
                    <feMergeNode in="blur" />
                    <feMergeNode in="SourceGraphic" />
                  </feMerge>
                </filter>
              </defs>

              <!-- Connector 1: LaTeX -> Markdown -->
              <rect x="178" y="46" width="104" height="24" fill="#0d0a06" stroke="rgba(255, 156, 26, 0.35)" stroke-width="1" />
              <text x="230" y="62" text-anchor="middle" fill="#ffb84d" font-family="'IBM Plex Mono', monospace" font-size="10" font-weight="600" letter-spacing="0.05em">MANUAL EXPORT</text>

              <!-- Connector 2: Markdown -> Summaries -->
              <rect x="418" y="46" width="124" height="24" fill="#0d0a06" stroke="rgba(255, 156, 26, 0.35)" stroke-width="1" />
              <text x="480" y="62" text-anchor="middle" fill="#ffb84d" font-family="'IBM Plex Mono', monospace" font-size="10" font-weight="600" letter-spacing="0.05em">AI SUMMARY</text>

              <!-- Connector 3: Summaries -> Folder & Skill -->
              <rect x="698" y="46" width="104" height="24" fill="#0d0a06" stroke="rgba(255, 156, 26, 0.35)" stroke-width="1" />
              <text x="750" y="62" text-anchor="middle" fill="#ffb84d" font-family="'IBM Plex Mono', monospace" font-size="10" font-weight="600" letter-spacing="0.05em">AI REVIEW</text>

              <!-- Node 1: LaTeX Papers -->
              <g transform="translate(20, 85)">
                <rect width="180" height="100" fill="#140f0a" stroke="rgba(255, 156, 26, 0.4)" stroke-width="2" />
                <rect width="180" height="26" fill="rgba(255, 156, 26, 0.1)" />
                <text x="90" y="18" text-anchor="middle" fill="#ffb84d" font-family="'IBM Plex Mono', monospace" font-size="11" font-weight="600">INPUT SOURCE</text>
                <text x="90" y="66" text-anchor="middle" fill="#f0e8dc" font-family="'Sora', sans-serif" font-size="18" font-weight="600">LaTeX Papers</text>
              </g>

              <!-- Node 2: Markdown Files -->
              <g transform="translate(260, 85)">
                <rect width="180" height="100" fill="#140f0a" stroke="rgba(255, 156, 26, 0.4)" stroke-width="2" />
                <rect width="180" height="26" fill="rgba(255, 156, 26, 0.1)" />
                <text x="90" y="18" text-anchor="middle" fill="#ffb84d" font-family="'IBM Plex Mono', monospace" font-size="11" font-weight="600">STRUCTURED TEXT</text>
                <text x="90" y="66" text-anchor="middle" fill="#f0e8dc" font-family="'Sora', sans-serif" font-size="18" font-weight="600">Markdown Files</text>
              </g>

              <!-- Node 3: Markdown Summaries -->
              <g transform="translate(520, 85)">
                <rect width="200" height="100" fill="#140f0a" stroke="rgba(255, 156, 26, 0.4)" stroke-width="2" />
                <rect width="200" height="26" fill="rgba(255, 156, 26, 0.1)" />
                <text x="100" y="18" text-anchor="middle" fill="#ffb84d" font-family="'IBM Plex Mono', monospace" font-size="11" font-weight="600">PER-PAPER DIGESTS</text>
                <text x="100" y="66" text-anchor="middle" fill="#f0e8dc" font-family="'Sora', sans-serif" font-size="17" font-weight="600">Markdown Summaries</text>
              </g>

              <!-- Node 4: Literature Folder & Skill -->
              <g transform="translate(780, 85)">
                <rect width="200" height="100" fill="#1b1208" stroke="#ff9c1a" stroke-width="2" filter="url(#outputGlow)" />
                <rect width="200" height="26" fill="rgba(255, 156, 26, 0.2)" />
                <text x="100" y="18" text-anchor="middle" fill="#fff5e0" font-family="'IBM Plex Mono', monospace" font-size="11" font-weight="700">KNOWLEDGE &amp; SKILL</text>
                <text x="100" y="62" text-anchor="middle" fill="#ff9c1a" font-family="'Sora', sans-serif" font-size="17" font-weight="700">Literature Folder</text>
                <text x="100" y="82" text-anchor="middle" fill="#ffffff" font-family="'Sora', sans-serif" font-size="16" font-weight="600">&amp; check-literature</text>
              </g>

              <!-- Connectors are drawn last so their lines remain visible between nodes. -->
              <line x1="201" y1="135" x2="259" y2="135" stroke="#ff7a3d" stroke-width="2" marker-end="url(#flowArrow)" />
              <line x1="441" y1="135" x2="519" y2="135" stroke="#ff7a3d" stroke-width="2" marker-end="url(#flowArrow)" />
              <line x1="721" y1="135" x2="779" y2="135" stroke="#ff7a3d" stroke-width="2" marker-end="url(#flowArrow)" />
            </svg>
          </div>
          <p class="text-void-400 text-xs font-mono mt-3 mb-0">
            Pipeline converting raw LaTeX source papers into an AI agent skill and thematic reference library.
          </p>
        </div>

        <!-- Literature Strategy Bullet Points -->
        <ul class="list-none space-y-2.5 pl-0 my-6 text-void-200 text-sm md:text-base">
          <li class="flex items-start gap-3">
            <span class="text-solar font-mono text-sm shrink-0">&#9670;</span>
            <span>Started with a subset of prior literature published by the <strong>MIT Aerospace Plasma Group</strong> on swept-stroke and zoning physics.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-solar font-mono text-sm shrink-0">&#9670;</span>
            <span>Converted the papers via the multi-stage ingestion pipeline into the <code class="text-solar font-mono text-xs bg-void-900 px-1.5 py-0.5 border border-solar/20">check-literature</code> agent skill for fast model and parameter reference.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-solar font-mono text-sm shrink-0">&#9670;</span>
            <span>The skill actively flags and records potential <strong>gaps in the literature</strong> whenever published sources lack necessary implementation details.</span>
          </li>
        </ul>
      </section>

      <!-- =========================================================================
           Section 2: Agent Strategy
           ========================================================================= -->
      <section>
        <h2 class="text-2xl md:text-3xl font-display font-bold text-void-100 mb-4">
          2. Agent Strategy
        </h2>

        <ul class="space-y-3 text-void-200 text-base md:text-lg leading-relaxed">
          <li class="flex items-start gap-3">
            <span class="text-solar font-mono text-sm shrink-0">&#9670;</span>
            <span>This will be a complex codebase, so sub-agents will be used for larger tasks. Conversations will be limited to a single backlog task per chat.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-solar font-mono text-sm shrink-0">&#9670;</span>
            <span>Using Backlog to manage tasks.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-solar font-mono text-sm shrink-0">&#9670;</span>
            <span>Using <code class="text-solar font-mono text-xs bg-void-900 px-1.5 py-0.5 border border-solar/20">AGENTS.md</code> to instruct agents to follow coding best practices and provide guidance on managing sub-agents.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-solar font-mono text-sm shrink-0">&#9670;</span>
            <span>Started with a long preparation and planning phase to get off to a good start.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-solar font-mono text-sm shrink-0">&#9670;</span>
            <span>Agents commit changes and I review them. Tests will be used to verify larger change sets that I cannot read in full.</span>
          </li>
        </ul>
      </section>

      <!-- =========================================================================
           Section 3: Skills, Tools, and Restrictions
           ========================================================================= -->
      <section>
        <h2 class="text-2xl md:text-3xl font-display font-bold text-void-100 mb-6">
          3. Skills, Tools, and Restrictions
        </h2>

        <!-- Shared SVG definitions for the diagrams in this section -->
        <svg width="0" height="0" class="absolute" aria-hidden="true">
          <defs>
            <marker id="s3Arrow" viewBox="0 0 12 12" refX="11" refY="6" markerWidth="12" markerHeight="12" markerUnits="userSpaceOnUse" orient="auto">
              <path d="M 1 1 L 11 6 L 1 11 z" fill="#ff7a3d" />
            </marker>
            <filter id="s3Glow">
              <feGaussianBlur stdDeviation="2" result="blur" />
              <feMerge>
                <feMergeNode in="blur" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
          </defs>
        </svg>

        <!-- ===== 3.1 Skills ===== -->
        <h3 class="font-mono text-xs uppercase tracking-widest text-solar mb-2">Skills</h3>

        <!-- check-literature -->
        <div class="project-sandbox-frame my-6">
          <div class="project-sandbox-frame__header">
            <span>check-literature</span>
            <span>Cited answer, or a logged gap</span>
          </div>

          <div class="w-full bg-void-950 p-4">
            <svg viewBox="0 0 1000 300" fill="none" xmlns="http://www.w3.org/2000/svg" class="block w-full h-auto">
              <!-- Agent question -->
              <g transform="translate(20, 112)">
                <rect width="170" height="86" fill="#140f0a" stroke="rgba(255, 156, 26, 0.4)" stroke-width="2" />
                <rect width="170" height="26" fill="rgba(255, 156, 26, 0.1)" />
                <text x="85" y="18" text-anchor="middle" fill="#ffb84d" font-family="'IBM Plex Mono', monospace" font-size="11" font-weight="600">AGENT</text>
                <text x="85" y="62" text-anchor="middle" fill="#f0e8dc" font-family="'Sora', sans-serif" font-size="17" font-weight="600">Physics question</text>
              </g>

              <!-- References -->
              <g transform="translate(250, 112)">
                <rect width="210" height="86" fill="#140f0a" stroke="rgba(255, 156, 26, 0.4)" stroke-width="2" />
                <rect width="210" height="26" fill="rgba(255, 156, 26, 0.1)" />
                <text x="105" y="18" text-anchor="middle" fill="#ffb84d" font-family="'IBM Plex Mono', monospace" font-size="11" font-weight="600">MARKDOWN SUMMARIES</text>
                <text x="105" y="62" text-anchor="middle" fill="#f0e8dc" font-family="'IBM Plex Mono', monospace" font-size="16" font-weight="600">references/</text>
              </g>

              <!-- Covered -->
              <g transform="translate(580, 26)">
                <rect width="230" height="80" fill="#140f0a" stroke="rgba(255, 156, 26, 0.4)" stroke-width="2" />
                <rect width="230" height="26" fill="rgba(255, 156, 26, 0.1)" />
                <text x="115" y="18" text-anchor="middle" fill="#ffb84d" font-family="'IBM Plex Mono', monospace" font-size="11" font-weight="600">COVERED</text>
                <text x="115" y="60" text-anchor="middle" fill="#f0e8dc" font-family="'Sora', sans-serif" font-size="17" font-weight="600">Answer + citation</text>
              </g>

              <!-- Not covered -->
              <g transform="translate(580, 204)">
                <rect width="180" height="80" fill="#140f0a" stroke="rgba(255, 156, 26, 0.4)" stroke-width="2" />
                <rect width="180" height="26" fill="rgba(255, 156, 26, 0.1)" />
                <text x="90" y="18" text-anchor="middle" fill="#ffb84d" font-family="'IBM Plex Mono', monospace" font-size="11" font-weight="600">NOT COVERED</text>
                <text x="90" y="60" text-anchor="middle" fill="#f0e8dc" font-family="'IBM Plex Mono', monospace" font-size="15" font-weight="600">record_gap.sh</text>
              </g>

              <!-- Gap log -->
              <g transform="translate(800, 204)">
                <rect width="180" height="80" fill="#1b1208" stroke="#ff9c1a" stroke-width="2" filter="url(#s3Glow)" />
                <rect width="180" height="26" fill="rgba(255, 156, 26, 0.2)" />
                <text x="90" y="18" text-anchor="middle" fill="#fff5e0" font-family="'IBM Plex Mono', monospace" font-size="11" font-weight="700">APPEND, THEN STOP</text>
                <text x="90" y="60" text-anchor="middle" fill="#ff9c1a" font-family="'IBM Plex Mono', monospace" font-size="15" font-weight="700">LIT_GAPS.md</text>
              </g>

              <!-- Connectors -->
              <line x1="191" y1="155" x2="248" y2="155" stroke="#ff7a3d" stroke-width="2" marker-end="url(#s3Arrow)" />
              <path d="M 461 155 H 520 V 66 H 578" stroke="#ff7a3d" stroke-width="2" marker-end="url(#s3Arrow)" />
              <path d="M 520 155 V 244 H 578" stroke="#ff7a3d" stroke-width="2" marker-end="url(#s3Arrow)" />
              <line x1="761" y1="244" x2="798" y2="244" stroke="#ff7a3d" stroke-width="2" marker-end="url(#s3Arrow)" />
            </svg>
          </div>
          <p class="text-void-400 text-xs font-mono mt-3 mb-0">
            Agents query the literature instead of assuming physics; unanswered questions are logged, not guessed.
          </p>
        </div>

        <!-- collab -->
        <div class="project-sandbox-frame my-6">
          <div class="project-sandbox-frame__header">
            <span>collab</span>
            <span>One sub-task per turn</span>
          </div>

          <div class="w-full bg-void-950 p-4">
            <svg viewBox="0 0 1000 250" fill="none" xmlns="http://www.w3.org/2000/svg" class="block w-full h-auto">
              <!-- Trigger -->
              <g transform="translate(40, 34)">
                <rect width="190" height="92" fill="#140f0a" stroke="rgba(255, 156, 26, 0.4)" stroke-width="2" />
                <rect width="190" height="26" fill="rgba(255, 156, 26, 0.1)" />
                <text x="95" y="18" text-anchor="middle" fill="#ffb84d" font-family="'IBM Plex Mono', monospace" font-size="11" font-weight="600">KEYWORD</text>
                <text x="95" y="66" text-anchor="middle" fill="#f0e8dc" font-family="'IBM Plex Mono', monospace" font-size="17" font-weight="600">collab</text>
              </g>

              <!-- Split -->
              <g transform="translate(280, 34)">
