---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FinalSlide from '../../components/project/FinalSlide.astro';
import FinalDeckControls from '../../components/project/FinalDeckControls.astro';
import LightningProcessAnimation from '../../components/project/LightningProcessAnimation.astro';
import { presentationGeometry } from '../../lib/presentationGeometry';
import '../../styles/final-presentation.css';
import ram1 from '../../images/sim_results/RAM1c_zoning.png';
import ram2 from '../../images/sim_results/RAM2_zoning.png';
import ram5 from '../../images/sim_results/RAM5_zoning.png';
import ram7 from '../../images/sim_results/RAM7_zoning.png';
import ttbw from '../../images/sim_results/TTBW_zoning.png';
import initialArcs from '../../images/sim_results/RAM2_init_arcs.png';
import zoningKey from '../../images/sim_results/zoning_key.png';
import comparison from '../../images/sim_results/Comparing_results.png';
import literature1 from '../../images/init_literature/screenshot_1.png';
import literature2 from '../../images/init_literature/screenshot_2.png';
import literature3 from '../../images/init_literature/screenshot_3.png';
import literature4 from '../../images/init_literature/screenshot_4.png';
import a220Export from '../../images/sim_results/AI_geoms/A220.html?raw';
import bizjetExport from '../../images/sim_results/AI_geoms/Bizjet.html?raw';

const geometries = [
  { label: 'A220', html: presentationGeometry(a220Export) },
  { label: 'Business jet', html: presentationGeometry(bizjetExport) },
];
const literature = [
  { image: literature1, alt: 'Numerical Simulation of the Lightning Swept Stroke for the Zoning of Unconventional Aircraft — thesis title page.' },
  { image: literature2, alt: 'Physical Interpretation of Swept Stroke Data — supplementary information.' },
  { image: literature3, alt: 'Numerical Simulation of the Lightning Swept Stroke: Application to the Results From the NASA Storm Hazards Program — article first page.' },
  { image: literature4, alt: 'A Physics-Based Approach to Aircraft Lightning Zoning: Zone 2 — article first page.' },
];
const skillGroups = [
  { label: 'Custom made', skills: [
    ['check-literature', 'Ground physics decisions'],
    ['remote-exec', 'Profile remote GPUs'],
    ['comment-only', 'Validate comment-only changes'],
    ['figure-styling', 'Style figures'],
  ] },
  { label: 'Made by others', skills: [
    ['ASD-STE100', 'Simplify technical writing'],
    ['pretty-mermaid', 'Create diagrams'],
    ['tdd', 'Test-first development'],
    ['walkthrough', 'Explain actual implementation'],
  ] },
];
// Use the logged stage times for both segment widths and label anchors.
const timings = [896.769908, 400.234695, 4.137622];
const total = timings.reduce((a, b) => a + b, 0);
const widths = timings.map(seconds => seconds / total * 1416);
const sweptX = widths[0] + 4;
const mappingX = sweptX + widths[1] + 4;
---

<BaseLayout title="Final Presentation · Project" description="Aircraft Lightning Zoning with AI agents: engineering workflows, numerical experiments, and simulation results." chrome={false}>
  <div class="final-deck" aria-label="Final Presentation">
    <div class="final-stage">
      <FinalSlide title="Aircraft Lightning Zoning with AI agents" class="cover">
        <div class="cover-copy">
          <h1>Aircraft<br />Lightning Zoning<br /><em>with AI agents</em></h1>
          <p class="byline"><strong>Nathanael Jenkins</strong><span>Final Presentation · November 2026</span></p>
        </div>
        <Image class="cover-image" src={initialArcs} width={1800} format="webp" quality={92} alt="Lightning arc ensemble radiating from a transport aircraft, generated by the zoning simulation." loading="eager" fetchpriority="high" />
      </FinalSlide>

      <FinalSlide title="Where does lightning attach—and where does it go next?" class="physics-slide">
        <h2>Where does lightning attach—<br />and where does it go next?</h2>
        <div class="physics-results">
          <LightningProcessAnimation presentation />
          <figure class="physics-zoning">
            <img class="deck-image" src={ram2.src} width="3840" height="2160" alt="Mid-size transport aircraft surface zoning diagram." />
          </figure>
        </div>
        <img class="zoning-key" src={zoningKey.src} width={zoningKey.width} height={zoningKey.height} alt="Key to the surface zoning colors." />
      </FinalSlide>

      <FinalSlide title="From literature to working software" class="literature-slide">
        <h2>From literature to working software</h2>
        <div class="columns development-stages">
          <div><span class="step-number">Early October</span><h3>Framework spike</h3><p>Benchmark candidates.<br />Select Python + Warp.</p></div>
          <div><span class="step-number">13–20 October</span><h3>Build the pipeline</h3></div>
          <div><span class="step-number">Late Oct–November</span><h3>Run and refine</h3><p>Profile GPU execution.<br />Debug with real data.</p></div>
        </div>
        <div class="literature-pages">
          {literature.map(({ image, alt }) => <img src={image.src} width={image.width} height={image.height} alt={alt} />)}
        </div>
      </FinalSlide>

      <FinalSlide title="The division of labor" class="labor-slide">
        <h2>The division of labor</h2>
        <div class="two-col labor-table">
          <div><h3>Agents</h3><ul class="clean-list"><li>Implement algorithms and tests</li><li>Profile and revise GPU execution</li><li>Maintain diagnostics and documentation</li></ul></div>
          <div><h3>Researcher</h3><ul class="clean-list"><li>Interpret the physical model</li><li>Challenge numerical assumptions</li><li>Inspect results and set priorities</li></ul></div>
        </div>
        <p class="profile-note"><strong>nono worker profile</strong> · Scoped filesystem access and SSH for remote GPU work.</p>
      </FinalSlide>

      <FinalSlide title="Skills in the workflow">
        <h2>Skills in the workflow</h2>
        <div class="skill-columns">
          {skillGroups.map(({ label, skills }) => <section>
            <h3 class="skill-column-label">{label}</h3>
            <dl class="skills-list">
              {skills.map(([name, purpose]) => <div><dt>{name}</dt><dd>{purpose}</dd></div>)}
            </dl>
          </section>)}
        </div>
      </FinalSlide>

      <FinalSlide title="AI-accelerated debugging">
        <h2>AI-accelerated debugging</h2>
        <div class="two-col">
          <p class="large-statement">Missing polarity check<br />led to<br /><em>spurious results</em></p>
          <ul class="clean-list"><li>Inspect actual implementation with agent walkthroughs.</li><li>Add diagnostics and probe the core under supervision.</li><li>Correct the polarity calculation.</li></ul>
        </div>
      </FinalSlide>

      <FinalSlide title="Throwaway code made more ideas testable" class="throwaway-slide">
        <h2>Throwaway code made more ideas testable</h2>
        <ol class="experiment-pipeline">
          <li><span class="step-number">01</span><h3>Idea</h3><p>Adaptive cut-cell<br />volume integration</p></li>
          <li><span class="step-number">02</span><h3>Test implementation</h3><p>Agent builds an<br />isolated alternative</p></li>
          <li><span class="step-number">03</span><h3>Quick debug</h3><p>Fix loop unrolling;<br />compilation &lt; 2 s</p></li>
          <li><span class="step-number">04</span><h3>Evaluate and implement</h3><p>Still too slow to run.<br />Throw away.</p></li>
        </ol>
      </FinalSlide>

      <FinalSlide title="Make the computation fit the GPU">
        <h2>Make the computation fit the GPU</h2>
        <div class="columns">
          <div><h3>Batch orientations</h3><p>Sized to free GPU memory.</p></div>
          <div><h3>Batch lightning arcs</h3></div>
          <div><h3>Keep intermediates</h3><p>Restart stages without repeating the entire pipeline.</p></div>
        </div>
        <p class="bottom-line">No longer a multi-week, hands-on activity…<br />agents accelerated code in just hours.</p>
      </FinalSlide>

      <FinalSlide title="One recorded run" class="recorded-run">
        <h2>One recorded run</h2>
        <div><span class="metric">21.7 <span class="metric-unit">minutes · Conventional transport aircraft</span></span></div>
        <svg class="timing-chart" viewBox="0 0 1424 210" role="img" aria-label="Initial attachment: 896.8 seconds. Swept stroke: 400.2 seconds. Zone mapping: 4.1 seconds.">
          <defs><linearGradient id="timing-solar" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="#ff6633" /><stop offset="100%" stop-color="#ffb84d" /></linearGradient></defs>
          <rect x="0" y="0" width={widths[0]} height="60" fill="url(#timing-solar)" />
          <rect x={sweptX} y="0" width={widths[1]} height="60" fill="#487f8b" />
          <rect x={mappingX} y="0" width={widths[2]} height="60" fill="#6b7169" />
          <g text-anchor="middle">
            <text x={widths[0] / 2} y="105">Initial attachment</text>
            <text class="timing-value" x={widths[0] / 2} y="149">896.8 s</text>
            <text x={sweptX + widths[1] / 2} y="105">Swept stroke</text>
            <text class="timing-value" x={sweptX + widths[1] / 2} y="149">400.2 s</text>
          </g>
          <path d={`M ${mappingX + widths[2] / 2} 64 V 190 H 1110`} fill="none" stroke="#6b7169" stroke-width="1.5" />
          <text x="1090" y="190" dominant-baseline="middle" text-anchor="end">Zone mapping · 4.1 s</text>
        </svg>
        <div class="run-stats"><p><strong>12,000</strong>field orientations</p><p><strong>5</strong>flow conditions</p><p><strong>120,000</strong>arc trajectories</p></div>
        <p class="bottom-line">Approximately 2.8× faster than the pre-AI implementation.</p>
      </FinalSlide>

      <FinalSlide title="Validating results" class="validation-slide">
        <h2>Validating results</h2>
        <div class="two-col validation-comparison">
          <figure class="comparison-figure">
            <img class="deck-image" src={comparison.src} width="1596" height="1622" alt="Working comparison of critical aircraft potential for second attachment: pre-AI implementation at top, new simulation at bottom. The original assembled plot formatting is preserved." />
            <figcaption><span class="comparison-label comparison-label--pre">Pre-AI</span><span class="comparison-label comparison-label--new">New simulation</span></figcaption>
          </figure>
          <div class="validation-copy"><p class="large-statement">Qualitative and<br />quantitative agreement<br /><em>with the pre-AI code.</em></p></div>
        </div>
      </FinalSlide>

      <FinalSlide title="The resulting surface zoning">
        <h2>The resulting surface zoning</h2>
        <img class="zoning-key" src={zoningKey.src} width={zoningKey.width} height={zoningKey.height} alt="Key to the surface zoning colors." />
        <figure class="hero-figure"><img class="deck-image" src={ram1.src} width="3840" height="2160" alt="Conventional transport aircraft surface zoning result, with distinct initial-attachment and swept-attachment regions." /><figcaption>Conventional transport aircraft</figcaption></figure>
      </FinalSlide>

      <FinalSlide title="Application to unconventional geometries">
        <h2>Application to unconventional geometries</h2>
        <img class="zoning-key" src={zoningKey.src} width={zoningKey.width} height={zoningKey.height} alt="Key to the surface zoning colors." />
        <div class="gallery">
          <figure><img src={ram2.src} width="3840" height="2160" alt="Mid-size transport aircraft zoning result." /><figcaption>Mid-size transport aircraft</figcaption></figure>
          <figure><img src={ram5.src} width="3840" height="2160" alt="Blended-wing body zoning result." /><figcaption>Blended-wing body</figcaption></figure>
          <figure><img src={ram7.src} width="3840" height="2160" alt="Large transport aircraft zoning result." /><figcaption>Large transport aircraft</figcaption></figure>
          <figure><img src={ttbw.src} width="1920" height="1080" alt="Truss-braced wing aircraft zoning result." /><figcaption>Truss-braced wing</figcaption></figure>
        </div>
      </FinalSlide>

      <FinalSlide title="Claude-generated geometries" class="geometry-slide">
        <h2>Claude-generated geometries</h2>
        <p class="geometry-credit">Generated with Fable 5.2.</p>
        <div class="geometry-models">
          {geometries.map(geometry => <figure>
            <iframe data-geometry data-geometry-source={geometry.html} title={`${geometry.label} interactive 3D aircraft geometry`} sandbox="allow-scripts" referrerpolicy="no-referrer" tabindex="0"></iframe>
            <figcaption>{geometry.label}</figcaption>
          </figure>)}
        </div>
      </FinalSlide>

      <FinalSlide title="What the agents made possible">
        <h2>What the agents made possible</h2>
        <div class="two-col">
          <p class="large-statement">A complete research<br />pipeline—and the tools<br /><em>to keep improving it.</em></p>
          <ul class="clean-list"><li>Rapid GPU acceleration</li><li>Tests, diagnostics, and restartable stages</li><li>Rapid exploration of new numerical methods</li></ul>
        </div>
      </FinalSlide>

      <FinalSlide title="What's next?" class="next-slide">
        <h2>What's next?</h2>
        <div class="next-steps">
          <p>Integrate CFD</p>
          <p>Integrate electrostatics</p>
          <p><em>Complete the end-to-end<br />zoning workflow</em></p>
          <svg class="next-arrows" viewBox="0 0 1424 600" fill="none" aria-hidden="true">
            <defs><marker id="next-arrowhead" viewBox="0 0 12 12" refX="10" refY="6" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M 2 2 L 10 6 L 2 10" stroke="currentColor" stroke-width="1.5" /></marker></defs>
            <path d="M 145 110 C 105 220, 235 240, 305 240" marker-end="url(#next-arrowhead)" />
            <path d="M 600 310 C 560 410, 655 430, 720 430" marker-end="url(#next-arrowhead)" />
          </svg>
        </div>
      </FinalSlide>
    </div>
    <FinalDeckControls />
    <noscript><p style="position: fixed; bottom: 60px; left: 24px; font-size: 16px; background: white;">Enable JavaScript to navigate this presentation.</p></noscript>
  </div>
</BaseLayout>
