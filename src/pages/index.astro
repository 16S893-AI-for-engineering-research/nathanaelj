---
import BaseLayout from '@layouts/BaseLayout.astro';
import LightningBackground from '@components/LightningBackground.tsx';
---

<BaseLayout title="Nathanael Jenkins">
  <LightningBackground client:only="react" />
  <div class="min-h-screen flex items-center justify-center relative overflow-hidden px-6 pt-20">
    <!-- Hero content -->
    <div class="max-w-4xl text-center z-10">
      <h1 class="text-6xl md:text-8xl font-display font-bold mb-16 pb-4 leading-tight">
        Nathanael Jenkins
      </h1>

      <p class="text-xl md:text-2xl text-void-200 mb-8 font-light font-sans">
        Developing new simulation techniques for aircraft lightning protection
      </p>

      <p class="text-base md:text-lg text-void-400 max-w-2xl mx-auto mb-16 leading-relaxed font-sans">
        Portfolio for MIT 16.S983: AI Agents for Engineering Research
      </p>

      <div class="flex flex-col sm:flex-row gap-6 justify-center">
        <a
          href="/about"
          class="inline-block px-8 py-3 border-2 border-solar text-solar font-sans font-medium hover:bg-solar/10 transition-all duration-300"
          style="border-color: #ff9c1a; color: #ff9c1a;"
        >
          Learn More →
        </a>

        <a
          href="/projects"
          class="inline-block px-8 py-3 bg-solar/10 text-solar font-sans font-medium border-2 border-solar hover:bg-solar/20 transition-all duration-300"
          style="border-color: #ff9c1a; color: #ff9c1a;"
        >
          View Projects →
        </a>
      </div>
    </div>

    <!-- Accent decoration - sharp geometric elements -->
    <div class="absolute top-1/4 right-10 w-96 h-96 opacity-5 pointer-events-none">
      <svg viewBox="0 0 200 200" class="w-full h-full">
        <line x1="0" y1="100" x2="200" y2="100" stroke="currentColor" stroke-width="0.5" class="text-solar" />
        <line x1="100" y1="0" x2="100" y2="200" stroke="currentColor" stroke-width="0.5" class="text-solar" />
        <line x1="0" y1="0" x2="200" y2="200" stroke="currentColor" stroke-width="0.5" class="text-solar" />
        <line x1="200" y1="0" x2="0" y2="200" stroke="currentColor" stroke-width="0.5" class="text-solar" />
      </svg>
    </div>

    <div class="absolute bottom-1/4 left-10 w-96 h-96 opacity-5 pointer-events-none">
      <svg viewBox="0 0 200 200" class="w-full h-full">
        <rect x="20" y="20" width="160" height="160" fill="none" stroke="currentColor" stroke-width="0.5" class="text-solar" />
        <rect x="50" y="50" width="100" height="100" fill="none" stroke="currentColor" stroke-width="0.5" class="text-solar" />
        <rect x="80" y="80" width="40" height="40" fill="none" stroke="currentColor" stroke-width="0.5" class="text-solar" />
      </svg>
    </div>
  </div>

  <!-- Featured section -->
  <section class="max-w-6xl mx-auto px-6 py-24 border-t border-solar/10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="group" data-reveal="1">
        <div class="mb-4 text-4xl">⚙️</div>
        <h3 class="font-sans text-xl font-bold mb-2 text-solar group-hover:text-flame transition-colors">
          Engineering
        </h3>
        <p class="text-void-400 text-sm font-sans">
          Rigorous analysis of atmospheric phenomena and aircraft systems.
        </p>
      </div>

      <div class="group" data-reveal="2">
        <div class="mb-4 text-4xl">🧠</div>
        <h3 class="font-sans text-xl font-bold mb-2 text-solar group-hover:text-flame transition-colors">
          Intelligence
        </h3>
        <p class="text-void-400 text-sm font-sans">
          AI agents and machine learning models for prediction and analysis.
        </p>
      </div>

      <div class="group" data-reveal="3">
        <div class="mb-4 text-4xl">📊</div>
        <h3 class="font-sans text-xl font-bold mb-2 text-solar group-hover:text-flame transition-colors">
          Research
        </h3>
        <p class="text-void-400 text-sm font-sans">
          Experimentation and development tracking for MIT coursework.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
